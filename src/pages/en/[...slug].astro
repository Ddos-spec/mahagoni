---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import GalleryGrid from '@/components/GalleryGrid.astro';
import { assets, blogPosts, clientLogos, commercialGallery, interiorGallery, oemGroups, site } from '@/data/site';

export function getStaticPaths() {
  return [
    { params: { slug: undefined }, props: { page: 'home' } },
    { params: { slug: 'about' }, props: { page: 'about' } },
    { params: { slug: 'services' }, props: { page: 'services' } },
    { params: { slug: 'services/oem-and-odm-product' }, props: { page: 'oem' } },
    { params: { slug: 'services/interior-contractor' }, props: { page: 'interior' } },
    { params: { slug: 'services/home-and-commercial' }, props: { page: 'commercial' } },
    { params: { slug: 'clients' }, props: { page: 'clients' } },
    { params: { slug: 'blog' }, props: { page: 'blog' } },
    { params: { slug: 'contact-us' }, props: { page: 'contact' } }
  ];
}

const { page } = Astro.props;
const projects=['PT Samsung Indonesia','PappaRich Office','DZ Bank','Yamaha Star Music','IES Jakarta','Bank Mandiri'];
const timeline=[
['2004','Established','Started with the “Eternity Kitchen” brand and kitchen-set design.'],
['2006','Own workshop','Established an in-house workshop in South Jakarta for kitchen and furniture production.'],
['2010','Expanded','Moved production to Depok and grew the manufacturing team.'],
['2014','Automation','Introduced CNC machinery to automate key production processes.'],
['2016','Capacity','Expanded the work area from approximately 1,000 m² to 2,000 m².'],
['2017','Export','Began exporting wooden panels to the UAE and Western Europe.'],
['2018','Japan','Started exporting wooden panels to Japan.'],
['2019','United States','Started exporting cabinetry to the USA.']
];
const meta = {
  home: ['Mahogani Utama Indonesia — Furniture Manufacturing & Interior','Furniture and cabinet manufacturing, OEM/ODM production and interior project execution.'],
  about: ['About — Mahogani Utama Indonesia','Mahogani Utama Indonesia history, capabilities, vision, mission and values.'],
  services: ['Services — Mahogani Utama Indonesia','Furniture manufacturing, OEM/ODM, interior contractor, home and commercial services.'],
  oem: ['OEM & ODM Furniture Manufacturing — Mahogani','OEM and ODM furniture manufacturing for kitchen cabinets, wardrobes, retail, office and special furniture.'],
  interior: ['Interior Contractor — Mahogani Utama Indonesia','Interior contractor portfolio and manufacturing execution by Mahogani Utama Indonesia.'],
  commercial: ['Home & Commercial Furniture — Mahogani','Home and commercial furniture portfolio by PT Mahogani Utama Indonesia.'],
  clients: ['Clients — Mahogani Utama Indonesia','Organizations and brands that have worked with Mahogani Utama Indonesia.'],
  blog: ['Journal — Mahogani Utama Indonesia','Furniture materials, cabinet knowledge and practical interior guidance from Mahogani.'],
  contact: ['Contact — Mahogani Utama Indonesia','Contact Mahogani Utama Indonesia for manufacturing, OEM/ODM and interior project inquiries.']
}[page] ?? ['Mahogani Utama Indonesia','Furniture manufacturing and interior project delivery.'];
---
<BaseLayout title={meta[0]} description={meta[1]}>
  {page === 'home' && <>
    <section class="hero"><img class="hero-media" src={assets.hero} alt="Mahogani woodworking production" fetchpriority="high" /><div class="hero-content" data-reveal><h1>Built to <em>make</em> ideas real.</h1><div class="hero-aside"><div class="eyebrow">Furniture manufacturing since 2004</div><p>Precision cabinetry, OEM/ODM production and interior execution for brands, designers, contractors and commercial projects.</p><div class="hero-actions"><a class="button filled" href="/en/services/oem-and-odm-product/">Explore capabilities ↗</a><a class="button" href="/en/contact-us/">Start a project</a></div></div></div></section>
    <div class="marquee" aria-hidden="true"><div class="marquee-track"><span>Woodworking <i>•</i> Automation <i>•</i> Quality Control <i>•</i> Large Capacity <i>•</i> Custom Design <i>•</i> Export <i>•</i></span><span>Woodworking <i>•</i> Automation <i>•</i> Quality Control <i>•</i> Large Capacity <i>•</i> Custom Design <i>•</i> Export <i>•</i></span></div></div>
    <section class="section"><div class="section-head" data-reveal><div class="kicker">About Mahogani</div><h2 class="section-title">Manufacturing discipline, without losing the human craft.</h2></div><div class="about-split"><img src={assets.about} alt="Mahogani factory production" loading="lazy" data-reveal /><div data-reveal><p class="section-copy">Mahogani Utama Indonesia works with furniture and cabinet brands, interior designers and contractors. The production floor combines experienced people with cabinetry machinery built for precision, repeatability and schedule control.</p><div class="pillars"><div class="pillar"><span class="kicker">01</span><h3>Woodworking</h3><p>Resources, capacity and production experience for current and future requirements.</p></div><div class="pillar"><span class="kicker">02</span><h3>Automation</h3><p>Machine-led repeatability to improve precision and production timing.</p></div><div class="pillar"><span class="kicker">03</span><h3>Quality</h3><p>Quality control embedded into the manufacturing process, not added at the end.</p></div><div class="pillar"><span class="kicker">04</span><h3>Capacity</h3><p>Efficient systems designed to support larger and repeat production volumes.</p></div></div></div></div></section>
    <section class="feature-strip"><article class="feature" data-reveal><img src="https://mahoganiutama.com/wp-content/uploads/2025/02/easy-ordering-and-customization.webp" alt="Easy ordering and customization" loading="lazy"/><div class="feature-text"><h3>Easy customization</h3><p>From specification to production, the process is structured around the actual design and volume requirement.</p></div></article><article class="feature" data-reveal><img src={assets.scheduling} alt="Mahogani production scheduling" loading="lazy"/><div class="feature-text"><h3>On-time scheduling</h3><p>Production, packaging and dispatch are coordinated as one delivery sequence.</p></div></article><article class="feature" data-reveal><img src={assets.quality} alt="Mahogani quality control" loading="lazy"/><div class="feature-text"><h3>Quality control</h3><p>Details are checked against project requirements for both domestic and international work.</p></div></article></section>
    <section class="world"><div class="world-inner" data-reveal><h2>From Depok to the world.</h2><div><div class="kicker">Export capability</div><p>Mahogani expanded from domestic work into export manufacturing, beginning with wooden panels for international markets and continuing with cabinetry programs for Asia, Europe, the Middle East and the United States.</p><a class="button" href="/en/about/">See our timeline ↗</a></div></div></section>
    <section class="section"><div class="section-head" data-reveal><div class="kicker">Selected projects</div><h2 class="section-title">Trusted across corporate, hospitality, finance and education.</h2></div><div class="project-list">{projects.map((p,i)=><a class="project-row" href="/en/clients/" data-reveal><span>{String(i+1).padStart(2,'0')}</span><strong>{p}</strong><span>View clients ↗</span></a>)}</div></section>
    <section class="section"><div class="section-head" data-reveal><div class="kicker">Journal</div><h2 class="section-title">Material notes, furniture knowledge and practical guidance.</h2></div><div class="blog-grid">{blogPosts.map(post=><a class="post-card" href={post.href} target="_blank" rel="noreferrer" data-reveal><img src={post.image} alt={post.title} loading="lazy"/><small>Mahogani Journal</small><h2>{post.title}</h2><p>{post.excerpt}</p><span class="button">Read article ↗</span></a>)}</div></section>
  </>}

  {page === 'about' && <><PageHero index="02" title="Built on production, proven by time." description="A furniture and cabinet manufacturing company combining experienced teams, automation and continuous quality improvement." image={assets.factory}/><section class="section"><div class="section-head" data-reveal><div class="kicker">Who we are</div><h2 class="section-title">A strategic manufacturing partner for interior and furniture businesses.</h2></div><div class="about-split"><div data-reveal><p class="section-copy">Mahogani supports furniture and cabinetry brands, interior designers and contractors with scalable woodworking production. The operational focus is simple: precision, consistency, capacity and reliable delivery.</p><div class="values"><article class="value"><b>V</b><h3>Vision</h3><p>Become a strategic partner in the domestic and international interior industry.</p></article><article class="value"><b>M</b><h3>Mission</h3><p>Deliver strong product and service quality while maintaining consistent production processes.</p></article><article class="value"><b>+</b><h3>Values</h3><p>Integrity, teamwork and humility in how projects are made and relationships are maintained.</p></article></div></div><img src={assets.about} alt="Mahogani production facility" loading="lazy" data-reveal/></div></section><section class="section"><div class="section-head" data-reveal><div class="kicker">Milestones</div><h2 class="section-title">Two decades of expanding capability.</h2></div><div class="timeline">{timeline.map(([year,title,body])=><div class="timeline-row" data-reveal><time>{year}</time><div><h3>{title}</h3><p>{body}</p></div></div>)}</div></section></>}

  {page === 'services' && <><PageHero index="03" eyebrow="Services" title="Production capability, organized around the project." description="OEM/ODM manufacturing, interior contracting and home or commercial furniture programs." image={assets.service2}/><section class="section"><div class="project-list"><a class="project-row" href="/en/services/oem-and-odm-product/"><span>01</span><strong>OEM / ODM Product</strong><span>Explore ↗</span></a><a class="project-row" href="/en/services/interior-contractor/"><span>02</span><strong>Interior Contractor</strong><span>Explore ↗</span></a><a class="project-row" href="/en/services/home-and-commercial/"><span>03</span><strong>Home & Commercial</strong><span>Explore ↗</span></a></div></section></>}

  {page === 'oem' && <><PageHero index="03" eyebrow="Manufacturing services" title="OEM / ODM, engineered for scale." description="Outsource furniture and cabinetry production without compromising specification, repeatability or quality control." image={assets.hero}/><section class="section"><div class="section-head" data-reveal><div class="kicker">Production partner</div><h2 class="section-title">Your design language. Our production system.</h2></div><div class="about-split"><p class="section-copy" data-reveal>OEM and ODM manufacturing can reduce the need for clients to carry their own production space, machinery and full operational overhead. Mahogani provides a structured path from specification through repeatable manufacturing and delivery.</p><img src={assets.service2} alt="Mahogani cabinetry production" loading="lazy" data-reveal/></div></section>{oemGroups.map(group=><section class="oem-group"><div class="oem-group-head" data-reveal><h2>{group.title}</h2><p>{group.body}</p></div><div class="oem-scroller">{group.images.map((src,i)=><img src={src} alt={`${group.title} ${i+1}`} loading="lazy" decoding="async"/>)}</div></section>)}</>}

  {page === 'interior' && <><PageHero index="04" eyebrow="Interior contractor" title="Interior execution, down to the millimeter." description="A project gallery from Mahogani’s current interior contractor portfolio." image={interiorGallery[0]}/><section class="section client-intro"><div class="section-head" data-reveal><div class="kicker">Selected work</div><h2 class="section-title">Made for the space, coordinated for the site.</h2></div><p class="section-copy" data-reveal>From built-in cabinetry to interior furniture packages, each project is approached as a coordination problem between design intent, production detail, material behavior and installation readiness.</p></section><GalleryGrid images={interiorGallery} prefix="Interior contractor project"/></>}

  {page === 'commercial' && <><PageHero index="05" eyebrow="Home & commercial" title="Furniture made for how spaces work." description="Residential and commercial project imagery from Mahogani’s existing portfolio." image={commercialGallery[0]}/><section class="section client-intro"><div class="section-head" data-reveal><div class="kicker">Residential + commercial</div><h2 class="section-title">Function first. Detail everywhere.</h2></div><p class="section-copy" data-reveal>Cabinetry and furniture are developed around the real constraints of the environment: scale, circulation, storage, finish, maintenance and the way people use the space every day.</p></section><GalleryGrid images={commercialGallery} prefix="Home and commercial project"/></>}

  {page === 'clients' && <><PageHero index="06" eyebrow="Clients" title="Trusted where execution matters." description="A selection of organizations and brands represented on Mahogani’s existing client page." image={assets.quality}/><section class="section client-intro"><div class="section-head" data-reveal><div class="kicker">Client network</div><h2 class="section-title">From finance and hospitality to education, property and enterprise.</h2></div><p class="section-copy" data-reveal>Some interior contractor relationships cannot be publicly disclosed due to privacy agreements. The names below reflect the publicly listed client set.</p></section><div class="logo-grid">{clientLogos.map(([name,src])=><div class="logo-cell" title={name} data-reveal><img src={src} alt={`${name} logo`} loading="lazy" decoding="async"/></div>)}</div><section class="section"><div class="world" style="margin:0 calc(var(--pad) * -1);"><div class="world-inner" data-reveal><h2>Have a program to manufacture?</h2><div><p>Send the drawing, quantity, material requirements and delivery target. We can align the production route from there.</p><a class="button" href="/en/contact-us/">Discuss your project ↗</a></div></div></div></section></>}

  {page === 'blog' && <><PageHero index="07" eyebrow="Journal" title="Notes from the world of furniture." description="Material knowledge, maintenance guidance and practical furniture references from Mahogani’s existing editorial archive." image={assets.service5}/><section class="section"><div class="blog-grid">{blogPosts.map(post=><a class="post-card" href={post.href} target="_blank" rel="noreferrer" data-reveal><img src={post.image} alt={post.title} loading="lazy"/><small>Archive article</small><h2>{post.title}</h2><p>{post.excerpt}</p><span class="button">Read original ↗</span></a>)}</div></section></>}

  {page === 'contact' && <><PageHero index="08" eyebrow="Contact" title="Tell us what needs to be made." description="For project inquiries, send the scope, drawings, target quantity and expected schedule. The more specific the brief, the faster the production conversation moves." image={assets.scheduling}/><section class="section"><div class="contact-grid"><div data-reveal><div class="contact-block"><span class="label">Email</span><a href={`mailto:${site.email}`}>{site.email}</a></div><div class="contact-block"><span class="label">WhatsApp</span><a href={`https://wa.me/${site.whatsapp}`}>+62 877 4760 3739</a></div><div class="contact-block"><span class="label">Office</span><p>{site.office}</p></div><div class="contact-block"><span class="label">Factory</span><p>{site.factory}</p></div></div><form class="contact-form" data-contact-form data-email={site.email} data-reveal><div class="field"><label for="name">Name</label><input id="name" name="name" autocomplete="name" required/></div><div class="field"><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" required/></div><div class="field"><label for="project">Project brief</label><textarea id="project" name="project" required placeholder="Project type, quantity, materials, dimensions, target schedule..."></textarea></div><button class="form-submit" type="submit">Continue via email ↗</button><small>This prototype routes the inquiry through your local mail client; no form data is stored on this site.</small></form></div></section></>}
  <script is:inline>
    document.querySelector('[data-contact-form]')?.addEventListener('submit', (event) => {
      event.preventDefault();
      const form = event.currentTarget;
      const f = new FormData(form);
      const subject = encodeURIComponent('Project inquiry — ' + (f.get('name') || 'Website'));
      const body = encodeURIComponent('Name: ' + f.get('name') + '\nEmail: ' + f.get('email') + '\n\nProject brief:\n' + f.get('project'));
      window.location.href = 'mailto:' + form.dataset.email + '?subject=' + subject + '&body=' + body;
    });
  </script>
</BaseLayout>
