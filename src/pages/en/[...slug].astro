---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import GalleryGrid from '@/components/GalleryGrid.astro';
import { assets, blogPosts, clientLogos, commercialGallery, interiorGallery, oemGroups, site } from '@/data/site';

export function getStaticPaths() {
  return [
    { params: { slug: undefined }, props: { page: 'home' } },
    { params: { slug: 'about' }, props: { page: 'about' } },
    { params: { slug: 'services' }, props: { page: 'services' } },
    { params: { slug: 'services/oem-and-odm-product' }, props: { page: 'oem' } },
    { params: { slug: 'services/interior-contractor' }, props: { page: 'interior' } },
    { params: { slug: 'services/home-and-commercial' }, props: { page: 'commercial' } },
    { params: { slug: 'clients' }, props: { page: 'clients' } },
    { params: { slug: 'blog' }, props: { page: 'blog' } },
    { params: { slug: 'contact-us' }, props: { page: 'contact' } }
  ];
}

const { page } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const link = (path: string) => `${base}${path}`;

const stats = [
  ['2004', 'Established'],
  ['2,000 m²', 'Production area milestone'],
  ['2017', 'Export expansion'],
  ['4', 'Core production disciplines']
];

const timeline = [
  ['2004','Established','Started with the Eternity Kitchen brand and kitchen-set design.'],
  ['2006','Own workshop','Established an in-house workshop in South Jakarta for kitchen and furniture production.'],
  ['2010','Expanded','Moved production to Depok and grew the manufacturing team.'],
  ['2014','Automation','Introduced CNC machinery to automate key production processes.'],
  ['2016','Capacity','Expanded the work area from approximately 1,000 m² to 2,000 m².'],
  ['2017','Export','Began exporting wooden panels to international markets.'],
  ['2018','Japan','Expanded export activity to Japan.'],
  ['2019','United States','Started exporting cabinetry to the United States.']
];

const process = [
  ['01','Brief','Drawings, quantity, finish and delivery target.'],
  ['02','Engineering','Production details are translated into a repeatable build plan.'],
  ['03','Material','Material and hardware are aligned to project specifications.'],
  ['04','Production','Machining, assembly and finishing move through controlled stages.'],
  ['05','Quality','Dimensions, finish and project requirements are checked.'],
  ['06','Delivery','Packing and dispatch are coordinated with the agreed schedule.']
];

const meta = {
  home: ['Mahogani Utama Indonesia — Furniture Manufacturing & Interior','Furniture and cabinet manufacturing, OEM/ODM production and interior project execution from Indonesia.'],
  about: ['About — Mahogani Utama Indonesia','Mahogani Utama Indonesia history, capabilities, vision, mission and values.'],
  services: ['Capabilities — Mahogani Utama Indonesia','OEM/ODM furniture manufacturing, interior contracting, home and commercial furniture programs.'],
  oem: ['OEM & ODM Furniture Manufacturing — Mahogani','OEM and ODM furniture manufacturing for kitchen cabinets, wardrobes, retail, office and special furniture.'],
  interior: ['Interior Contractor — Mahogani Utama Indonesia','Interior contractor portfolio and manufacturing execution by Mahogani Utama Indonesia.'],
  commercial: ['Home & Commercial Furniture — Mahogani','Home and commercial furniture portfolio by PT Mahogani Utama Indonesia.'],
  clients: ['Clients — Mahogani Utama Indonesia','Organizations and brands represented on Mahogani Utama Indonesia’s public client list.'],
  blog: ['Journal — Mahogani Utama Indonesia','Furniture materials, cabinet knowledge and practical interior guidance from Mahogani.'],
  contact: ['Contact — Mahogani Utama Indonesia','Contact Mahogani Utama Indonesia for manufacturing, OEM/ODM and interior project inquiries.']
}[page] ?? ['Mahogani Utama Indonesia','Furniture manufacturing and interior project delivery.'];

const projectImages = [interiorGallery[0], commercialGallery[2], interiorGallery[5], commercialGallery[7], interiorGallery[10], commercialGallery[12]];
const previewClients = clientLogos.slice(0, 12);
---
<BaseLayout title={meta[0]} description={meta[1]}>
  {page === 'home' && <>
    <section class="hero">
      <img class="hero-media" src={assets.hero} alt="Mahogani furniture manufacturing and interior production" fetchpriority="high" decoding="async" />
      <div class="hero-scrim"></div>
      <div class="hero-content">
        <div class="hero-main" data-reveal>
          <div class="eyebrow light">Furniture manufacturing · Indonesia</div>
          <h1>Made to spec.<br/><em>Built to scale.</em></h1>
        </div>
        <div class="hero-aside" data-reveal>
          <p>OEM/ODM cabinetry, furniture production and interior execution for brands, designers, contractors and commercial projects.</p>
          <div class="hero-actions">
            <a class="button filled" href={link('/en/services/')}>Explore capabilities <span>↗</span></a>
            <a class="button ghost" href={link('/en/contact-us/')}>Send a brief</a>
          </div>
        </div>
      </div>
      <div class="hero-foot"><span>Mahogani Utama Indonesia</span><span>Since 2004</span></div>
    </section>

    <section class="stat-band" aria-label="Company milestones">
      {stats.map(([value,label]) => <div class="stat" data-reveal><strong>{value}</strong><span>{label}</span></div>)}
    </section>

    <section class="section intro-section">
      <div class="section-head" data-reveal>
        <div class="kicker">About Mahogani</div>
        <h2 class="section-title">Manufacturing discipline with room for custom work.</h2>
      </div>
      <div class="editorial-split">
        <div class="media-frame portrait" data-reveal><img src={assets.about} alt="Mahogani production facility" loading="lazy" decoding="async" /></div>
        <div class="editorial-copy" data-reveal>
          <p class="section-copy">Mahogani works with furniture and cabinet brands, interior designers and contractors. The production floor combines experienced people with cabinetry machinery built for precision, repeatability and schedule control.</p>
          <div class="pillars compact">
            <div class="pillar"><span>01</span><h3>Woodworking</h3><p>Production resources and hands-on cabinet experience.</p></div>
            <div class="pillar"><span>02</span><h3>Automation</h3><p>Machine-led repeatability for precision and timing.</p></div>
            <div class="pillar"><span>03</span><h3>Quality</h3><p>Checks embedded into the production sequence.</p></div>
            <div class="pillar"><span>04</span><h3>Capacity</h3><p>Systems designed for larger and repeat volumes.</p></div>
          </div>
        </div>
      </div>
    </section>

    <section class="capability-index">
      <div class="capability-intro" data-reveal>
        <div class="kicker">Capabilities</div>
        <h2>Three routes.<br/>One production partner.</h2>
      </div>
      <div class="capability-list">
        <a class="capability-row" href={link('/en/services/oem-and-odm-product/')} data-reveal>
          <span class="cap-number">01</span><div><small>Manufacturing</small><h3>OEM / ODM Product</h3><p>Cabinetry and furniture production developed around your specification and quantity.</p></div><b>↗</b>
        </a>
        <a class="capability-row" href={link('/en/services/interior-contractor/')} data-reveal>
          <span class="cap-number">02</span><div><small>Project execution</small><h3>Interior Contractor</h3><p>Built-in cabinetry and interior packages coordinated from production detail to site readiness.</p></div><b>↗</b>
        </a>
        <a class="capability-row" href={link('/en/services/home-and-commercial/')} data-reveal>
          <span class="cap-number">03</span><div><small>Project furniture</small><h3>Home & Commercial</h3><p>Furniture and cabinetry shaped around the way residential and commercial spaces work.</p></div><b>↗</b>
        </a>
      </div>
    </section>

    <section class="process-section">
      <div class="process-heading" data-reveal><div class="kicker light">Production flow</div><h2>From drawing<br/>to delivery.</h2></div>
      <div class="process-grid">
        {process.map(([num,title,body]) => <article class="process-card" data-reveal><span>{num}</span><h3>{title}</h3><p>{body}</p></article>)}
      </div>
    </section>

    <section class="section work-section">
      <div class="section-head" data-reveal><div class="kicker">Selected work</div><h2 class="section-title">The work should carry the argument.</h2></div>
      <div class="project-mosaic">
        {projectImages.map((src,i) => <a class:list={['project-tile', {'project-tile-wide': i === 0 || i === 5}]} href={i % 2 ? link('/en/services/home-and-commercial/') : link('/en/services/interior-contractor/')} data-reveal>
          <img src={src} alt={`Mahogani selected project ${i+1}`} loading="lazy" decoding="async" />
          <div class="project-tile-meta"><span>{String(i+1).padStart(2,'0')}</span><strong>{i % 2 ? 'Home & Commercial' : 'Interior Contractor'}</strong><b>View ↗</b></div>
        </a>)}
      </div>
    </section>

    <section class="client-band">
      <div class="client-band-head" data-reveal><div class="kicker">Public client list</div><h2>Trusted across sectors.</h2><a href={link('/en/clients/')}>See all clients ↗</a></div>
      <div class="logo-marquee">
        {previewClients.map(([name,src]) => <div class="logo-mini" title={name}><img src={src} alt={`${name} logo`} loading="lazy" decoding="async" /></div>)}
      </div>
    </section>

    <section class="world">
      <div class="world-inner">
        <div data-reveal><div class="kicker light">Export experience</div><h2>From Depok<br/>to global markets.</h2></div>
        <div class="world-copy" data-reveal><p>Mahogani expanded from domestic projects into export manufacturing, including wooden panels and cabinetry programs for international markets.</p><a class="button ghost light-border" href={link('/en/about/')}>See the company timeline <span>↗</span></a></div>
      </div>
    </section>

    <section class="section journal-section">
      <div class="section-head" data-reveal><div class="kicker">Journal</div><h2 class="section-title">Material notes and practical furniture knowledge.</h2></div>
      <div class="blog-grid">
        {blogPosts.map(post => <a class="post-card" href={post.href} target="_blank" rel="noreferrer" data-reveal>
          <div class="post-media"><img src={post.image} alt={post.title} loading="lazy" decoding="async" /></div><small>Mahogani Journal</small><h3>{post.title}</h3><p>{post.excerpt}</p><span class="text-link">Read article ↗</span>
        </a>)}
      </div>
    </section>
  </>}

  {page === 'about' && <>
    <PageHero index="02" eyebrow="About" title="Built through production, not presentation." description="Two decades of furniture and cabinet manufacturing shaped by capacity, automation and continuous improvement." image={assets.factory}/>
    <section class="stat-band inner">{stats.map(([value,label]) => <div class="stat" data-reveal><strong>{value}</strong><span>{label}</span></div>)}</section>
    <section class="section">
      <div class="section-head" data-reveal><div class="kicker">Who we are</div><h2 class="section-title">A manufacturing partner for furniture and interior businesses.</h2></div>
      <div class="editorial-split reverse">
        <div class="editorial-copy" data-reveal><p class="section-copy">Mahogani supports furniture and cabinetry brands, interior designers and contractors with scalable woodworking production. The operational focus is straightforward: precision, consistency, capacity and reliable delivery.</p><div class="values-inline"><article><span>V</span><h3>Vision</h3><p>Become a strategic partner in the domestic and international interior industry.</p></article><article><span>M</span><h3>Mission</h3><p>Deliver strong product and service quality through consistent production processes.</p></article><article><span>+</span><h3>Values</h3><p>Integrity, teamwork and humility in how projects are made and relationships are maintained.</p></article></div></div>
        <div class="media-frame landscape" data-reveal><img src={assets.about} alt="Mahogani furniture production" loading="lazy" decoding="async" /></div>
      </div>
    </section>
    <section class="section timeline-section"><div class="section-head" data-reveal><div class="kicker">Milestones</div><h2 class="section-title">Capability built one stage at a time.</h2></div><div class="timeline">{timeline.map(([year,title,body]) => <div class="timeline-row" data-reveal><time>{year}</time><div><h3>{title}</h3><p>{body}</p></div></div>)}</div></section>
  </>}

  {page === 'services' && <>
    <PageHero index="03" eyebrow="Capabilities" title="Choose the production route that fits the project." description="OEM/ODM manufacturing, interior execution and home or commercial furniture programs." image={assets.service2}/>
    <section class="section capability-cards">
      <a class="service-card" href={link('/en/services/oem-and-odm-product/')} data-reveal><div class="service-card-media"><img src={assets.heroFallback} alt="OEM and ODM furniture manufacturing" loading="lazy" /></div><div class="service-card-copy"><span>01 · Manufacturing</span><h2>OEM / ODM Product</h2><p>Outsource furniture and cabinetry production around your drawing, quantity, material and quality requirements.</p><b>Explore capability ↗</b></div></a>
      <a class="service-card reverse-card" href={link('/en/services/interior-contractor/')} data-reveal><div class="service-card-media"><img src={interiorGallery[0]} alt="Mahogani interior contractor project" loading="lazy" /></div><div class="service-card-copy"><span>02 · Project execution</span><h2>Interior Contractor</h2><p>Built-in cabinetry and interior furniture packages produced with site coordination in mind.</p><b>Explore capability ↗</b></div></a>
      <a class="service-card" href={link('/en/services/home-and-commercial/')} data-reveal><div class="service-card-media"><img src={commercialGallery[0]} alt="Mahogani home and commercial furniture" loading="lazy" /></div><div class="service-card-copy"><span>03 · Project furniture</span><h2>Home & Commercial</h2><p>Custom furniture and cabinetry developed around scale, function, finish and the way a space is used.</p><b>Explore capability ↗</b></div></a>
    </section>
    <section class="process-section"><div class="process-heading" data-reveal><div class="kicker light">How work moves</div><h2>Structured<br/>for delivery.</h2></div><div class="process-grid">{process.map(([num,title,body]) => <article class="process-card" data-reveal><span>{num}</span><h3>{title}</h3><p>{body}</p></article>)}</div></section>
  </>}

  {page === 'oem' && <>
    <PageHero index="03.1" eyebrow="OEM / ODM" title="Your specification. Our production system." description="Furniture and cabinetry manufacturing engineered for repeatability, volume and consistent finishing." image={assets.heroFallback}/>
    <section class="section">
      <div class="section-head" data-reveal><div class="kicker">Production partner</div><h2 class="section-title">Scale production without carrying the full factory overhead.</h2></div>
      <div class="two-column-copy"><p class="section-copy" data-reveal>OEM and ODM manufacturing can reduce the need to carry production space, machinery and a full operating team internally. Mahogani provides a structured path from specification to repeatable manufacturing and delivery.</p><div class="mini-proof" data-reveal><div><strong>Cabinetry</strong><span>Kitchen & wardrobe programs</span></div><div><strong>Retail</strong><span>Repeat furniture production</span></div><div><strong>Office</strong><span>Custom and standardized products</span></div><div><strong>Special</strong><span>Non-standard wood-based products</span></div></div></div>
    </section>
    {oemGroups.map((group,gi) => <section class="oem-group"><div class="oem-group-head" data-reveal><div><span>{String(gi+1).padStart(2,'0')}</span><h2>{group.title}</h2></div><p>{group.body}</p></div><div class="oem-scroller">{group.images.map((src,i) => <figure><img src={src} alt={`${group.title} ${i+1}`} loading="lazy" decoding="async"/><figcaption>{String(i+1).padStart(2,'0')}</figcaption></figure>)}</div></section>)}
  </>}

  {page === 'interior' && <>
    <PageHero index="04" eyebrow="Interior contractor" title="Built for the drawing. Ready for the site." description="Interior project imagery from Mahogani’s public portfolio." image={interiorGallery[0]}/>
    <section class="section portfolio-intro"><div class="section-head" data-reveal><div class="kicker">Project execution</div><h2 class="section-title">Production detail has to survive real site conditions.</h2></div><div class="two-column-copy"><p class="section-copy" data-reveal>Built-in cabinetry and interior furniture are coordinated around material behavior, dimensions, finishing, access and installation readiness.</p><div class="scope-list" data-reveal><span>Production detailing</span><span>Built-in cabinetry</span><span>Furniture fabrication</span><span>Quality control</span><span>Packing & site readiness</span></div></div></section>
    <GalleryGrid images={interiorGallery} prefix="Interior contractor project"/>
  </>}

  {page === 'commercial' && <>
    <PageHero index="05" eyebrow="Home & commercial" title="Furniture made around how the space works." description="Residential and commercial project imagery from Mahogani’s public portfolio." image={commercialGallery[0]}/>
    <section class="section portfolio-intro"><div class="section-head" data-reveal><div class="kicker">Residential + commercial</div><h2 class="section-title">Function first. Detail everywhere.</h2></div><div class="two-column-copy"><p class="section-copy" data-reveal>Cabinetry and furniture are developed around scale, circulation, storage, finish, maintenance and how people use the space every day.</p><div class="scope-list" data-reveal><span>Kitchen cabinetry</span><span>Wardrobes & storage</span><span>Office furniture</span><span>Retail furniture</span><span>Custom furniture</span></div></div></section>
    <GalleryGrid images={commercialGallery} prefix="Home and commercial project"/>
  </>}

  {page === 'clients' && <>
    <PageHero index="06" eyebrow="Clients" title="Credibility is earned in execution." description="A selection of organizations and brands represented on Mahogani’s public client list." image={assets.quality}/>
    <section class="section client-intro"><div class="section-head" data-reveal><div class="kicker">Client network</div><h2 class="section-title">Finance, hospitality, property, enterprise and education.</h2></div><p class="section-copy" data-reveal>Some project relationships cannot be publicly disclosed. The names below reflect Mahogani’s publicly listed client set.</p></section>
    <div class="logo-grid">{clientLogos.map(([name,src]) => <div class="logo-cell" title={name} data-reveal><img src={src} alt={`${name} logo`} loading="lazy" decoding="async"/><span>{name}</span></div>)}</div>
    <section class="project-name-band"><div class="kicker light">Selected public project names</div><div class="project-name-list"><span>PT Samsung Indonesia</span><span>PappaRich Office</span><span>DZ Bank</span><span>Yamaha Star Music</span><span>IES Jakarta</span><span>Bank Mandiri</span></div></section>
  </>}

  {page === 'blog' && <>
    <PageHero index="07" eyebrow="Journal" title="Furniture knowledge without the filler." description="Material references, maintenance guidance and practical furniture notes from Mahogani’s editorial archive." image={assets.service5}/>
    <section class="section"><div class="blog-grid">{blogPosts.map(post => <a class="post-card" href={post.href} target="_blank" rel="noreferrer" data-reveal><div class="post-media"><img src={post.image} alt={post.title} loading="lazy" decoding="async"/></div><small>Archive article</small><h3>{post.title}</h3><p>{post.excerpt}</p><span class="text-link">Read original ↗</span></a>)}</div></section>
  </>}

  {page === 'contact' && <>
    <PageHero index="08" eyebrow="Contact" title="Start with the drawing, quantity and target date." description="The more specific the brief, the faster the production conversation moves." image={assets.scheduling}/>
    <section class="section contact-section">
      <div class="contact-grid">
        <div data-reveal>
          <div class="contact-block"><span class="label">Email</span><a href={`mailto:${site.email}`}>{site.email}</a></div>
          <div class="contact-block"><span class="label">WhatsApp</span><a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noreferrer">+62 877 4760 3739</a></div>
          <div class="contact-block"><span class="label">Office</span><p>{site.office}</p></div>
          <div class="contact-block"><span class="label">Factory</span><p>{site.factory}</p></div>
        </div>
        <form class="contact-form" id="project-brief" data-reveal>
          <div class="form-intro"><div class="kicker">Project brief</div><h2>Send the essentials.</h2></div>
          <div class="field"><label for="name">Name / company</label><input id="name" name="name" autocomplete="name" required /></div>
          <div class="field"><label for="scope">What do you need made?</label><textarea id="scope" name="scope" required></textarea></div>
          <div class="form-two"><div class="field"><label for="qty">Quantity</label><input id="qty" name="qty" /></div><div class="field"><label for="target">Target date</label><input id="target" name="target" /></div></div>
          <button class="form-submit" type="submit">Send via WhatsApp <span>↗</span></button>
        </form>
      </div>
    </section>
    <script is:inline define:vars={{ whatsapp: site.whatsapp }}>
      document.getElementById('project-brief')?.addEventListener('submit', (event) => {
        event.preventDefault();
        const form = new FormData(event.currentTarget);
        const message = [`Hello Mahogani, I would like to discuss a project.`,`Name / company: ${form.get('name') || '-'}`,`Scope: ${form.get('scope') || '-'}`,`Quantity: ${form.get('qty') || '-'}`,`Target date: ${form.get('target') || '-'}`].join('\n');
        window.open(`https://wa.me/${whatsapp}?text=${encodeURIComponent(message)}`, '_blank', 'noopener,noreferrer');
      });
    </script>
  </>}
</BaseLayout>
