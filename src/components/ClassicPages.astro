---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { assets, blogPosts, clientLogos, commercialGallery, interiorGallery, oemGroups, site } from '@/data/site';

interface Props { lang: 'en' | 'id'; page: string; }
const { lang, page } = Astro.props;
const isId = lang === 'id';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (path: string) => `${base}/${lang}${path}`;

const projects = ['PT Samsung Indonesia','PappaRich Office','DZ Bank','Yamaha Star Music','IES Jakarta','Bank Mandiri'];
const capabilityImages = [assets.service1, assets.service2, assets.quality, assets.factory];
const whyImages = [assets.easyOrdering, assets.scheduling, assets.quality];
const selectedProjectImages = [interiorGallery[0], commercialGallery[2], interiorGallery[5], commercialGallery[7], interiorGallery[10], commercialGallery[12]];

const copy = isId ? {
  meta: {
    home:['Mahogani Utama Indonesia — Manufaktur Furnitur & Interior','Manufaktur furnitur dan kabinet, produksi OEM/ODM, kontraktor interior, serta furnitur hunian dan komersial.'],
    about:['Tentang — Mahogani Utama Indonesia','Sejarah, visi, misi, nilai, dan perkembangan kapabilitas PT Mahogani Utama Indonesia.'],
    services:['Layanan — Mahogani Utama Indonesia','OEM/ODM, kontraktor interior, serta furnitur hunian dan komersial.'],
    oem:['OEM & ODM — Mahogani Utama Indonesia','Produksi OEM dan ODM furnitur untuk kitchen cabinet, wardrobe, retail, office, dan special furniture.'],
    interior:['Kontraktor Interior — Mahogani Utama Indonesia','Portofolio kontraktor interior Mahogani Utama Indonesia.'],
    commercial:['Hunian & Komersial — Mahogani Utama Indonesia','Portofolio furnitur hunian dan komersial Mahogani Utama Indonesia.'],
    clients:['Klien — Mahogani Utama Indonesia','Daftar klien publik Mahogani Utama Indonesia.'],
    blog:['Artikel — Mahogani Utama Indonesia','Artikel material, furnitur, kabinet, dan referensi interior dari Mahogani.'],
    contact:['Hubungi Kami — Mahogani Utama Indonesia','Hubungi Mahogani untuk kebutuhan manufaktur, OEM/ODM, dan proyek interior.']
  },
  heroTitle:'Visi yang Luas\nLayanan yang Jujur\nNilai yang Luar Biasa', heroSub:'Tujuan kami dulu dan sekarang adalah menghadirkan proyek berkualitas dan tepat waktu.', services:'Layanan Kami', contact:'Hubungi Kami',
  about:'tentang.', aboutText:'PT Mahogani Utama Indonesia adalah perusahaan manufaktur furnitur dan kabinet yang bekerja sama dengan brand furnitur/kabinet, desainer interior, dan kontraktor. Fasilitas produksi kami didukung mesin cabinetry serta tenaga berpengalaman untuk menjaga presisi, konsistensi, dan ketepatan waktu.',
  capabilities:[['PENGOLAHAN KAYU','Kami memiliki sumber daya, kapasitas, dan pengalaman woodworking untuk memenuhi kebutuhan pelanggan saat ini maupun pengembangan berikutnya.'],['OTOMATISASI','Kami memaksimalkan teknologi dan mesin produksi untuk meningkatkan presisi, repeatability, dan ketepatan waktu.'],['KUALITAS','Kami berkomitmen memberikan layanan manufaktur berkualitas melalui kontrol proses dan peningkatan berkelanjutan.'],['KAPASITAS BESAR','Sistem kerja yang efektif dan efisien mendukung kebutuhan produksi dalam volume besar maupun berulang.']],
  see:'Lihat Apa yang Bisa Kami Lakukan', why:'kenapa kami.', whyItems:[['Pemesanan dan Kustomisasi yang Mudah','Spesifikasi, desain, material, dan kuantitas dapat disesuaikan dengan kebutuhan proyek melalui alur produksi yang terstruktur.'],['Penjadwalan Tepat Waktu','Produksi, pengemasan, dan pengiriman dikoordinasikan untuk menjaga jadwal proyek tetap terkendali.'],['Kontrol Kualitas Tinggi','Setiap detail diperiksa agar hasil produksi memenuhi kebutuhan proyek nasional maupun internasional.']],
  worldwide:'di seluruh dunia.', worldwideText:'Mahogani Utama Indonesia terus berkembang dari proyek domestik menuju manufaktur ekspor. Sejak 2017, pengalaman ekspor berkembang dari panel kayu untuk Eropa, kemudian Jepang, hingga cabinetry untuk Amerika Serikat.',
  projects:'proyek.', allProjects:'Lihat Semua Proyek', blog:'artikel.', allBlog:'Lihat Semua Artikel', read:'Baca artikel',
  contactTitle:'Hubungi kami', contactText:'Temukan solusi yang tepat untuk proyek furnitur Anda. Sampaikan gambar kerja, kebutuhan produk, kuantitas, material, dan target waktu kepada tim kami.', contactCta:'Mulai diskusi',
  pageTitles:{about:'Tentang',services:'Layanan',oem:'OEM dan ODM Product',interior:'Kontraktor Interior',commercial:'Hunian dan Komersial',clients:'Klien',blog:'Artikel',contact:'Hubungi Kami'},
  aboutLead:'Dua dekade membangun kapabilitas manufaktur melalui pengalaman, otomasi, perluasan kapasitas, dan ekspor.', vision:'Visi', visionText:'Menjadi mitra strategis dalam industri interior domestik dan internasional.', mission:'Misi', missionText:'Memberikan kualitas produk dan layanan melalui proses produksi yang konsisten.', values:'Nilai', valuesText:'Integritas, kerja sama tim, dan kerendahan hati dalam produksi serta hubungan bisnis.',
  timeline:[['2004','Berdiri','Dimulai dari merek Eternity Kitchen dan layanan desain kitchen set.'],['2006','Workshop sendiri','Mendirikan workshop internal di Jakarta Selatan.'],['2010','Ekspansi','Memindahkan fasilitas produksi ke Depok dan memperbesar tim.'],['2014','Otomasi','Mengadopsi mesin CNC untuk proses produksi utama.'],['2016','Kapasitas','Memperluas area kerja dari sekitar 1.000 m² menjadi 2.000 m².'],['2017','Ekspor','Memulai ekspor panel kayu ke pasar internasional.'],['2018','Jepang','Memperluas aktivitas ekspor ke Jepang.'],['2019','Amerika Serikat','Memulai ekspor cabinetry ke Amerika Serikat.']],
  serviceIntro:'Pilih jalur layanan sesuai kebutuhan proyek Anda.', serviceCards:[['OEM / ODM Product','Produksi furnitur dan cabinetry berdasarkan spesifikasi, kuantitas, material, dan standar kualitas Anda.'],['Kontraktor Interior','Produksi built-in cabinetry dan furnitur interior yang terkoordinasi dengan kebutuhan lapangan.'],['Hunian & Komersial','Furnitur custom untuk hunian, kantor, retail, hospitality, dan kebutuhan ruang komersial.']],
  oemIntro:'Produksi OEM dan ODM memberi perusahaan akses pada fasilitas, mesin, tenaga produksi, dan skala tanpa harus menanggung seluruh investasi pabrik sendiri.', oemBodies:['Kitchen dan wardrobe cabinet dengan kualitas produksi yang mendukung kebutuhan lokal maupun ekspor.','Furnitur retail dengan kualitas konsisten untuk toko, brand, marketplace, dan program volume berulang.','Furnitur kantor custom maupun standar untuk kebutuhan perusahaan, institusi, dan pemerintahan.','Dukungan produksi untuk furnitur atau produk berbasis kayu dengan bentuk dan spesifikasi khusus.'],
  portfolioIntro:'Portofolio proyek dari arsip publik Mahogani.', clientsNote:'Sebagian hubungan proyek tidak dapat ditampilkan karena kebijakan privasi. Logo berikut berasal dari daftar klien publik Mahogani.',
  formTitle:'Kirim Pesan', name:'Nama / Perusahaan', scope:'Kebutuhan / Pertanyaan', qty:'Kuantitas', target:'Target Waktu', send:'Kirim melalui WhatsApp', info:'Informasi Kontak', location:'Lokasi Pabrik', email:'Email', phone:'Telepon / WhatsApp'
} : {
  meta: {
    home:['Mahogani Utama Indonesia — Furniture Manufacturer & Interior','Furniture and cabinet manufacturing, OEM/ODM production, interior contracting, and home or commercial furniture.'],
    about:['About — Mahogani Utama Indonesia','History, vision, mission, values, and manufacturing capability of PT Mahogani Utama Indonesia.'],
    services:['Services — Mahogani Utama Indonesia','OEM/ODM manufacturing, interior contracting, and home or commercial furniture.'],
    oem:['OEM & ODM Product — Mahogani Utama Indonesia','OEM and ODM furniture production for kitchen cabinets, wardrobes, retail, office, and special furniture.'],
    interior:['Interior Contractor — Mahogani Utama Indonesia','Interior contractor portfolio by Mahogani Utama Indonesia.'],
    commercial:['Home and Commercial — Mahogani Utama Indonesia','Home and commercial furniture portfolio by Mahogani Utama Indonesia.'],
    clients:['Clients — Mahogani Utama Indonesia','Public client list of Mahogani Utama Indonesia.'],
    blog:['Blog — Mahogani Utama Indonesia','Furniture materials, cabinetry, and practical interior references from Mahogani.'],
    contact:['Contact Us — Mahogani Utama Indonesia','Contact Mahogani for furniture manufacturing, OEM/ODM, and interior projects.']
  },
  heroTitle:'Broad Vision\nHonest Service\nGreat Value', heroSub:'Our goal then and now is to provide quality, on-time projects.', services:'Our Services', contact:'Get In Touch',
  about:'about.', aboutText:'PT Mahogani Utama Indonesia is a furniture and cabinet manufacturing company working with furniture and cabinet brands, interior designers, and contractors. Our production facility combines cabinetry machinery with experienced people to maintain precision, consistency, and reliable schedules.',
  capabilities:[['WOOD WORKING','We have the resources, capacity, and woodworking experience required for current and future customer needs.'],['AUTOMATION','We maximize production technology and machinery to improve precision, repeatability, and timeliness.'],['QUALITY','We are committed to quality manufacturing through process control and continuous improvement.'],['LARGE CAPACITY','An effective and efficient working system supports large and repeat production volumes.']],
  see:'See What We Can Do', why:'why us.', whyItems:[['Easy Ordering and Customization','Specifications, design, materials, and quantities can be adjusted to project requirements through a structured production flow.'],['On-time Scheduling','Production, packaging, and dispatch are coordinated to keep project schedules under control.'],['High Quality Control','Details are checked so production can meet national and international project requirements.']],
  worldwide:'worldwide.', worldwideText:'Mahogani Utama Indonesia continues to expand from domestic projects into export manufacturing. Since 2017, export experience has grown from wooden panels for Europe to Japan and cabinetry for the United States.',
  projects:'projects.', allProjects:'View All Projects', blog:'blog.', allBlog:'View All Blog', read:'Read article',
  contactTitle:'Contact us', contactText:'Find the right solution for your furniture project. Share your drawing, product requirement, quantity, material, and target schedule with our team.', contactCta:'Start a conversation',
  pageTitles:{about:'About',services:'Services',oem:'OEM and ODM Product',interior:'Interior Contractor',commercial:'Home and Commercial',clients:'Clients',blog:'Blog',contact:'Contact Us'},
  aboutLead:'Two decades of manufacturing capability built through experience, automation, expanded capacity, and export activity.', vision:'Vision', visionText:'Become a strategic partner in the domestic and international interior industry.', mission:'Mission', missionText:'Deliver strong product and service quality through consistent production processes.', values:'Values', valuesText:'Integrity, teamwork, and humility in production and business relationships.',
  timeline:[['2004','Established','Started with the Eternity Kitchen brand and kitchen-set design.'],['2006','Own workshop','Established an in-house workshop in South Jakarta.'],['2010','Expanded','Moved production to Depok and grew the manufacturing team.'],['2014','Automation','Introduced CNC machinery into key production processes.'],['2016','Capacity','Expanded the work area from approximately 1,000 m² to 2,000 m².'],['2017','Export','Began exporting wooden panels to international markets.'],['2018','Japan','Expanded export activity to Japan.'],['2019','United States','Started exporting cabinetry to the United States.']],
  serviceIntro:'Choose the service route that matches your project requirements.', serviceCards:[['OEM / ODM Product','Furniture and cabinetry production around your specification, quantity, material, and quality standard.'],['Interior Contractor','Built-in cabinetry and interior furniture coordinated around production and site requirements.'],['Home & Commercial','Custom furniture for residential, office, retail, hospitality, and commercial spaces.']],
  oemIntro:'OEM and ODM production gives companies access to manufacturing space, machinery, production expertise, and scale without carrying the full factory investment internally.', oemBodies:['Kitchen and wardrobe cabinet production supporting local and export requirements.','Retail furniture with consistent production for stores, brands, marketplaces, and repeat-volume programs.','Custom and standard office furniture for companies, institutions, and government needs.','Production support for wood-based furniture or products with non-standard forms and specifications.'],
  portfolioIntro:'Project imagery from Mahogani’s public portfolio.', clientsNote:'Some project relationships cannot be publicly displayed due to privacy policy. The logos below come from Mahogani’s public client list.',
  formTitle:'Send Us A Message', name:'Name / Company', scope:'Comments / Questions', qty:'Quantity', target:'Target Date', send:'Send via WhatsApp', info:'Contact Info', location:'Factory Location', email:'Email', phone:'Phone / WhatsApp'
};

const meta = copy.meta[page] ?? copy.meta.home;
const pageImage = page === 'interior' ? interiorGallery[0] : page === 'commercial' ? commercialGallery[0] : page === 'oem' ? assets.heroFallback : page === 'clients' ? assets.quality : page === 'blog' ? assets.service5 : page === 'contact' ? assets.scheduling : assets.factory;
---
<BaseLayout title={meta[0]} description={meta[1]}>
{page === 'home' && <>
  <section class="classic-hero">
    <img class="classic-hero-media" src={assets.hero} alt="Mahogani furniture manufacturing" width="2200" height="1467" fetchpriority="high" decoding="async" />
    <div class="classic-hero-overlay"></div>
    <div class="classic-hero-inner" data-reveal>
      <div class="classic-hero-copy">
        <p class="classic-overline">PT Mahogani Utama Indonesia · Since 2004</p>
        <h1>{copy.heroTitle.split('\n').map((line) => <span>{line}</span>)}</h1>
        <p>{copy.heroSub}</p>
        <div class="classic-actions"><a class="classic-btn primary" href={href('/services/')}>{copy.services}</a><a class="classic-btn ghost" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noreferrer">{copy.contact}</a></div>
      </div>
    </div>
  </section>

  <section class="classic-section classic-about">
    <div class="classic-heading"><span>01</span><h2>{copy.about}</h2></div>
    <div class="classic-about-grid">
      <div class="classic-about-copy" data-reveal><p>{copy.aboutText}</p><a class="classic-text-link" href={href('/about/')}>{isId ? 'Selengkapnya tentang Mahogani' : 'More about Mahogani'} ↗</a></div>
      <div class="classic-about-image" data-reveal><img src={assets.about} alt="Mahogani production facility" width="1400" height="930" loading="lazy" decoding="async" /></div>
    </div>
    <div class="classic-capabilities">
      {copy.capabilities.map(([title,body],i) => <article class="classic-capability" data-reveal><div class="classic-cap-image"><img src={capabilityImages[i]} alt="" width="900" height="650" loading="lazy" decoding="async" /></div><span>0{i+1}</span><h3>{title}</h3><p>{body}</p></article>)}
    </div>
  </section>

  <section class="classic-showcase">
    <div class="classic-showcase-head" data-reveal><p>{copy.see}</p><a href={href('/services/')}>{copy.services} ↗</a></div>
    <div class="classic-showcase-grid">
      <a href={href('/services/oem-and-odm-product/')}><img src={assets.heroFallback} alt="OEM ODM furniture" width="1200" height="850" loading="lazy"/><span>OEM / ODM</span></a>
      <a href={href('/services/interior-contractor/')}><img src={interiorGallery[0]} alt="Interior Contractor" width="1200" height="850" loading="lazy"/><span>{isId?'Kontraktor Interior':'Interior Contractor'}</span></a>
      <a href={href('/services/home-and-commercial/')}><img src={commercialGallery[0]} alt="Home and Commercial" width="1200" height="850" loading="lazy"/><span>{isId?'Hunian & Komersial':'Home & Commercial'}</span></a>
    </div>
  </section>

  <section class="classic-section classic-why">
    <div class="classic-heading"><span>02</span><h2>{copy.why}</h2></div>
    <div class="classic-why-list">
      {copy.whyItems.map(([title,body],i) => <article class:list={['classic-why-row',{'reverse':i%2===1}]} data-reveal><div class="classic-why-media"><img src={whyImages[i]} alt={title} width="1400" height="930" loading="lazy" decoding="async" /></div><div class="classic-why-copy"><span>0{i+1}</span><h3>{title}</h3><p>{body}</p></div></article>)}
    </div>
  </section>

  <section class="classic-worldwide"><div class="classic-worldwide-inner" data-reveal><span>03</span><div><h2>{copy.worldwide}</h2><p>{copy.worldwideText}</p><a class="classic-btn ghost light" href={href('/about/')}>{isId?'Lihat perjalanan Mahogani':'See our journey'}</a></div></div></section>

  <section class="classic-section classic-projects">
    <div class="classic-heading split"><div><span>04</span><h2>{copy.projects}</h2></div><a href={href('/clients/')}>{copy.allProjects} ↗</a></div>
    <div class="classic-project-grid">{projects.map((name,i) => <a href={href('/clients/')} class="classic-project" data-reveal><div class="classic-project-img"><img src={selectedProjectImages[i]} alt={name} width="1200" height="900" loading="lazy" decoding="async" /></div><div><span>{String(i+1).padStart(2,'0')}.</span><h3>{name}</h3></div></a>)}</div>
  </section>

  <section class="classic-section classic-blog">
    <div class="classic-heading split"><div><span>05</span><h2>{copy.blog}</h2></div><a href={href('/blog/')}>{copy.allBlog} ↗</a></div>
    <div class="classic-blog-grid">{blogPosts.map((post) => <a class="classic-post" href={post.href} target="_blank" rel="noreferrer" data-reveal><img src={post.image} alt={post.title} width="900" height="600" loading="lazy" decoding="async"/><small>Mahogani Journal</small><h3>{post.title}</h3><p>{post.excerpt}</p><b>{copy.read} ↗</b></a>)}</div>
  </section>

  <section class="classic-contact-band"><div data-reveal><span>06</span><h2>{copy.contactTitle}</h2><p>{copy.contactText}</p><a class="classic-btn primary" href={href('/contact-us/')}>{copy.contactCta}</a></div></section>
</>}

{page !== 'home' && <>
  <section class="classic-page-hero"><img src={pageImage} alt="" width="1800" height="1100" fetchpriority="high" decoding="async"/><div></div><div class="classic-page-hero-inner"><p>PT Mahogani Utama Indonesia</p><h1>{copy.pageTitles[page]}</h1></div></section>

  {page === 'about' && <>
    <section class="classic-section classic-inner-intro"><div class="classic-heading"><span>01</span><h2>{copy.about}</h2></div><div class="classic-intro-two"><p class="lead">{copy.aboutLead}</p><p>{copy.aboutText}</p></div></section>
    <section class="classic-values"><article><span>01</span><h3>{copy.vision}</h3><p>{copy.visionText}</p></article><article><span>02</span><h3>{copy.mission}</h3><p>{copy.missionText}</p></article><article><span>03</span><h3>{copy.values}</h3><p>{copy.valuesText}</p></article></section>
    <section class="classic-section"><div class="classic-heading"><span>02</span><h2>{isId?'perjalanan.':'milestones.'}</h2></div><div class="classic-timeline">{copy.timeline.map(([year,title,body]) => <div><time>{year}</time><h3>{title}</h3><p>{body}</p></div>)}</div></section>
  </>}

  {page === 'services' && <section class="classic-section"><div class="classic-inner-intro"><p class="lead">{copy.serviceIntro}</p></div><div class="classic-service-list">{copy.serviceCards.map(([title,body],i) => { const paths=['/services/oem-and-odm-product/','/services/interior-contractor/','/services/home-and-commercial/']; const imgs=[assets.heroFallback,interiorGallery[0],commercialGallery[0]]; return <a href={href(paths[i])} class="classic-service-row"><img src={imgs[i]} alt={title} width="1200" height="850" loading="lazy"/><span>0{i+1}</span><div><h2>{title}</h2><p>{body}</p><b>{isId?'Lihat layanan':'View service'} ↗</b></div></a> })}</div></section>}

  {page === 'oem' && <>
    <section class="classic-section classic-inner-intro"><div class="classic-heading"><span>01</span><h2>OEM / ODM</h2></div><div class="classic-intro-two"><p class="lead">{copy.oemIntro}</p><p>{isId?'Mahogani mendukung kitchen dan wardrobe cabinet, retail furniture, office furniture, serta special furniture.':'Mahogani supports kitchen and wardrobe cabinets, retail furniture, office furniture, and special furniture.'}</p></div></section>
    {oemGroups.map((group,i) => <section class="classic-product-group"><div class="classic-product-head"><span>0{i+1}</span><div><h2>{group.title}</h2><p>{copy.oemBodies[i]}</p></div></div><div class="classic-product-grid">{group.images.map((src,j)=><figure><img src={src} alt={`${group.title} ${j+1}`} width="1100" height="850" loading="lazy" decoding="async"/><figcaption>{String(j+1).padStart(2,'0')}</figcaption></figure>)}</div></section>)}
  </>}

  {(page === 'interior' || page === 'commercial') && <section class="classic-section"><div class="classic-inner-intro"><div class="classic-heading"><span>01</span><h2>{page === 'interior' ? (isId?'proyek interior.':'interior projects.') : (isId?'hunian & komersial.':'home & commercial.')}</h2></div><p class="lead">{copy.portfolioIntro}</p></div><div class="classic-gallery">{(page==='interior'?interiorGallery:commercialGallery).map((src,i)=><figure data-reveal><img src={src} alt={`${copy.pageTitles[page]} ${i+1}`} width="1200" height="900" loading="lazy" decoding="async"/><figcaption>{String(i+1).padStart(2,'0')}</figcaption></figure>)}</div></section>}

  {page === 'clients' && <section class="classic-section"><div class="classic-inner-intro"><div class="classic-heading"><span>01</span><h2>{isId?'dipercaya lintas sektor.':'trusted across sectors.'}</h2></div><p class="lead">{copy.clientsNote}</p></div><div class="classic-logo-grid">{clientLogos.map(([name,src]) => <div><img src={src} alt={`${name} logo`} width="260" height="120" loading="lazy" decoding="async"/><span>{name}</span></div>)}</div></section>}

  {page === 'blog' && <section class="classic-section"><div class="classic-blog-grid">{blogPosts.map((post) => <a class="classic-post" href={post.href} target="_blank" rel="noreferrer"><img src={post.image} alt={post.title} width="900" height="600" loading="lazy" decoding="async"/><small>Mahogani Journal</small><h3>{post.title}</h3><p>{post.excerpt}</p><b>{copy.read} ↗</b></a>)}</div></section>}

  {page === 'contact' && <section class="classic-section classic-contact-page"><div class="classic-contact-form"><div class="classic-heading"><span>01</span><h2>{copy.formTitle}</h2></div><form id="classic-contact-form"><label>{copy.name}<input name="name" autocomplete="name" required /></label><label>{copy.scope}<textarea name="scope" required></textarea></label><div class="classic-form-two"><label>{copy.qty}<input name="qty" inputmode="numeric" /></label><label>{copy.target}<input name="target" /></label></div><button type="submit">{copy.send} ↗</button></form></div><aside class="classic-contact-info"><div class="classic-heading"><span>02</span><h2>{copy.info}</h2></div><div><small>{copy.location}</small><p>{site.factory}</p></div><div><small>{copy.email}</small><p><a href={`mailto:${site.email}`}>{site.email}</a></p></div><div><small>{copy.phone}</small><p>{site.phone.join(' · ')}<br/><a href={`https://wa.me/${site.whatsapp}`}>+62 877 4760 3739</a></p></div></aside></section>}
  {page === 'contact' && <script is:inline define:vars={{ whatsapp:site.whatsapp, isId }}>
    document.getElementById('classic-contact-form')?.addEventListener('submit',(event)=>{event.preventDefault();const form=new FormData(event.currentTarget);const intro=isId?'Halo Mahogani, saya ingin mendiskusikan proyek.':'Hello Mahogani, I would like to discuss a project.';const labels=isId?['Nama / Perusahaan','Kebutuhan','Kuantitas','Target Waktu']:['Name / Company','Requirement','Quantity','Target Date'];const msg=[intro,`${labels[0]}: ${form.get('name')||'-'}`,`${labels[1]}: ${form.get('scope')||'-'}`,`${labels[2]}: ${form.get('qty')||'-'}`,`${labels[3]}: ${form.get('target')||'-'}`].join('\n');window.open(`https://wa.me/${whatsapp}?text=${encodeURIComponent(msg)}`,'_blank','noopener,noreferrer');});
  </script>}
</>}
</BaseLayout>
