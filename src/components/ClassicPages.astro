---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { assets, blogPosts, clientLogos, commercialGallery, interiorGallery, oemGroups, site } from '@/data/site';

interface Props { lang: 'en' | 'id'; page: string; }
const { lang, page } = Astro.props;
const isId = lang === 'id';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (path: string) => `${base}/${lang}${path}`;

const projects = ['PT Samsung Indonesia','PappaRich Office','DZ Bank','Yamaha Star Music','IES Jakarta','Bank Mandiri'];
const capabilityImages = [assets.service1, assets.service2, assets.quality, assets.factory];
const whyImages = [assets.easyOrdering, assets.scheduling, assets.quality];
const selectedProjectImages = [interiorGallery[0], commercialGallery[2], interiorGallery[5], commercialGallery[7], interiorGallery[10], commercialGallery[12]];

const copy = isId ? {
  meta: {
    home:['Mahogani Utama Indonesia — Manufaktur Furnitur & Interior','Manufaktur furnitur dan kabinet, produksi OEM/ODM, kontraktor interior, serta furnitur hunian dan komersial.'],
    about:['Tentang — Mahogani Utama Indonesia','Sejarah, visi, misi, nilai, dan perkembangan kapabilitas PT Mahogani Utama Indonesia.'],
    services:['Layanan — Mahogani Utama Indonesia','OEM/ODM, kontraktor interior, serta furnitur hunian dan komersial.'],
    oem:['OEM & ODM — Mahogani Utama Indonesia','Produksi OEM dan ODM furnitur untuk kitchen cabinet, wardrobe, retail, office, dan special furniture.'],
    interior:['Kontraktor Interior — Mahogani Utama Indonesia','Portofolio kontraktor interior Mahogani Utama Indonesia.'],
    commercial:['Hunian & Komersial — Mahogani Utama Indonesia','Portofolio furnitur hunian dan komersial Mahogani Utama Indonesia.'],
    clients:['Klien — Mahogani Utama Indonesia','Daftar klien publik Mahogani Utama Indonesia.'],
    blog:['Artikel — Mahogani Utama Indonesia','Artikel material, furnitur, kabinet, dan referensi interior dari Mahogani.'],
    contact:['Hubungi Kami — Mahogani Utama Indonesia','Hubungi Mahogani untuk kebutuhan manufaktur, OEM/ODM, dan proyek interior.']
  },
  heroTitle:'Visi yang Luas\nLayanan yang Jujur\nNilai yang Luar Biasa',
  heroSub:'Tujuan kami dulu dan sekarang adalah menyediakan proyek yang berkualitas dan tepat waktu.',
  services:'Layanan Kami', contact:'Hubungi Kami',
  about:'tentang.',
  aboutText:'PT Mahogani Utama Indonesia adalah perusahaan manufaktur furnitur/kabinet yang bekerja sama dengan merek furnitur/kabinet, desainer interior, dan kontraktor. Dilengkapi mesin dalam industri cabinetry dan tenaga berpengalaman di bidang produksi kabinet.',
  capabilities:[
    ['PENGOLAHAN KAYU','Kami memiliki sumber daya, kapasitas, dan pengalaman yang diperlukan dalam pekerjaan kayu untuk memenuhi kebutuhan pelanggan saat ini dan masa depan.'],
    ['OTOMATISASI','Kami memaksimalkan tenaga mesin dan teknologi produksi untuk menghasilkan presisi dan ketepatan waktu.'],
    ['KUALITAS','Kami berkomitmen untuk terus memberikan layanan manufaktur yang berkualitas melalui peningkatan berkelanjutan.'],
    ['KAPASITAS BESAR','Sistem kerja yang efektif dan efisien membuat kami memiliki kapasitas produksi yang besar.']
  ],
  see:'Lihat Apa yang Bisa Kami Lakukan', why:'kenapa kami.',
  whyItems:[
    ['Pemesanan dan Kustomisasi yang Mudah','Lakukan pemesanan dengan mudah dan sesuaikan pilihan Anda agar sesuai dengan kebutuhan melalui opsi kustomisasi yang fleksibel.'],
    ['Penjadwalan Tepat Waktu','Kami bekerja untuk memastikan produksi selesai, pengemasan, dan pengiriman berjalan tepat waktu.'],
    ['Kontrol Kualitas Tinggi','Kami menjaga setiap detail agar kontrol kualitas memenuhi kebutuhan pelanggan secara nasional maupun global.']
  ],
  worldwide:'di seluruh dunia.',
  worldwideText:'Mahogani Utama Indonesia terus melakukan ekspansi secara global dan nasional dengan kapasitas produksi serta kualitas berstandar tinggi. Pada 2017 kami mulai mengekspor panel kayu ke Eropa, kemudian diikuti ekspor ke Jepang dan Amerika.',
  projects:'proyek.', allProjects:'Lihat Semua Proyek', blog:'artikel.', allBlog:'Lihat Semua Artikel', read:'Baca artikel',
  contactTitle:'Hubungi kami',
  contactText:'Temukan solusi yang tepat untuk proyek furnitur Anda. Baik untuk desain khusus, keahlian produksi, maupun kebutuhan material berkualitas, tim kami siap membantu mewujudkan kebutuhan proyek.',
  contactCta:'Hubungi kami',
  pageTitles:{about:'Tentang',services:'Layanan',oem:'OEM dan ODM Product',interior:'Kontraktor Interior',commercial:'Hunian dan Komersial',clients:'Klien',blog:'Artikel',contact:'Hubungi Kami'},
  vision:'visi.', visionText:'Menjadi mitra strategis dalam industri interior domestik dan internasional.',
  mission:'misi.', missionItems:['Berkomitmen pada kualitas produk dan layanan terbaik yang mengantisipasi tren dan kebutuhan kenyamanan.','Konsisten dalam produksi produk dan proses.'],
  value:'nilai.', valueItems:[['Integritas','Menjaga kejujuran dan tanggung jawab dalam proses kerja dan hubungan bisnis.'],['Kerja Sama Tim','Mendorong kolaborasi yang kuat untuk menghasilkan pekerjaan yang konsisten.'],['Kerendahan Hati','Terus belajar, memperbaiki proses, dan menghargai setiap pihak dalam proyek.']],
  milestone:'pencapaian.',
  timeline:[['2004','Didirikan','Didirikan dengan merek “Eternity Kitchen” dan layanan desain kitchen set.'],['2006','Workshop','Memiliki workshop sendiri di Jakarta Selatan untuk memproduksi kitchen set dan produk furnitur lainnya.'],['2010','Pindah','Memindahkan dan memperluas workshop ke Depok, dengan tim berpengalaman di bidang produksi.'],['2014','Otomatisasi','Dilengkapi mesin CNC untuk otomatisasi proses produksi.'],['2016','Diperluas','Memperluas area kerja dari sekitar 1.000 m² menjadi 2.000 m².'],['2017','Ekspor ke UEA','Mulai mengekspor panel kayu ke UEA dan Eropa Barat.'],['2018','Ekspor ke Jepang','Mulai mengekspor panel kayu ke Jepang.'],['2019','Ekspor ke Amerika Serikat','Mulai mengekspor cabinetry ke Amerika Serikat.']],
  serviceIntro:'Pilih jalur layanan sesuai kebutuhan proyek Anda.',
  serviceCards:[['Produk OEM / ODM','Produksi furnitur dan cabinetry berdasarkan spesifikasi, kuantitas, material, dan standar kualitas Anda.'],['Kontraktor Interior','Produksi built-in cabinetry dan furnitur interior yang terkoordinasi dengan kebutuhan lapangan.'],['Hunian & Komersial','Furnitur custom untuk hunian, kantor, retail, hospitality, dan kebutuhan ruang komersial.']],
  oemIntro1:'Produksi OEM dan ODM biasanya lebih kompetitif dari segi biaya karena skala ekonomi. Dengan melakukan outsourcing kepada kami, perusahaan dapat menghemat biaya modal untuk mesin dan ruang pabrik.',
  oemIntro2:'Anda juga memperoleh manfaat operasional, termasuk dukungan terhadap perubahan biaya bahan baku sehingga perencanaan anggaran dan produksi dapat lebih terkendali.',
  oemBodies:['Dengan kualitas yang memenuhi persyaratan ekspor, kami memproduksi kitchen dan wardrobe cabinet menggunakan referensi American Standard dan Euro Standard.','Dengan banyaknya marketplace, kami menyediakan produk furnitur retail dengan kualitas baik dan harga produksi yang kompetitif.','Furnitur kantor custom dan standar untuk kebutuhan perusahaan, lokal, institusi, dan pemerintahan.','Kami menyediakan jasa pembuatan produk berbahan kayu berdasarkan kebutuhan dan desain dari product designer.'],
  portfolioIntro:'Portofolio proyek dari arsip publik Mahogani.',
  clientsNote:'Masih terdapat banyak kontraktor interior dan hubungan proyek lain yang tidak dapat disebutkan karena kebijakan privasi.',
  formTitle:'Kirim Pesan', name:'Nama', emailLabel:'Alamat Email', phoneLabel:'Telepon', scope:'Komentar / Pertanyaan', send:'Kirim melalui WhatsApp', info:'Informasi Kontak', location:'Lokasi Kami', email:'Email Kami', follow:'Ikuti Kami'
} : {
  meta: {
    home:['Mahogani Utama Indonesia — Furniture Manufacturer & Interior','Furniture and cabinet manufacturing, OEM/ODM production, interior contracting, and home or commercial furniture.'],
    about:['About — Mahogani Utama Indonesia','History, vision, mission, values, and manufacturing capability of PT Mahogani Utama Indonesia.'],
    services:['Services — Mahogani Utama Indonesia','OEM/ODM manufacturing, interior contracting, and home or commercial furniture.'],
    oem:['OEM & ODM Product — Mahogani Utama Indonesia','OEM and ODM furniture production for kitchen cabinets, wardrobes, retail, office, and special furniture.'],
    interior:['Interior Contractor — Mahogani Utama Indonesia','Interior contractor portfolio by Mahogani Utama Indonesia.'],
    commercial:['Home and Commercial — Mahogani Utama Indonesia','Home and commercial furniture portfolio by Mahogani Utama Indonesia.'],
    clients:['Clients — Mahogani Utama Indonesia','Public client list of Mahogani Utama Indonesia.'],
    blog:['Blog — Mahogani Utama Indonesia','Furniture materials, cabinetry, and practical interior references from Mahogani.'],
    contact:['Contact Us — Mahogani Utama Indonesia','Contact Mahogani for furniture manufacturing, OEM/ODM, and interior projects.']
  },
  heroTitle:'Broad Vision\nHonest Service\nGreat Value',
  heroSub:'Our goal then and now is to provide quality, on-time projects.',
  services:'Our Services', contact:'Get In Touch',
  about:'about.',
  aboutText:'PT Mahogani Utama Indonesia is a furniture/cabinet manufacturing company that cooperates with furniture/cabinet brands, interior designers, and contractors. The company is supported by cabinetry machinery and experienced people in cabinet production.',
  capabilities:[
    ['WOOD WORKING','We have the resources, capacity, and experience in woodworking to meet current and future customer requirements.'],
    ['AUTOMATION','We maximize production technology and machine capability to produce precision and timeliness.'],
    ['QUALITY','We are committed to consistently providing quality manufacturing service through continuous improvement.'],
    ['LARGE CAPACITY','An effective and efficient working system gives us the capacity to support large production volumes.']
  ],
  see:'See What We Can Do', why:'why us.',
  whyItems:[
    ['Easy Ordering and Customization','Place orders and personalize specifications to fit your project needs with flexible customization options.'],
    ['On-time Scheduling','We work to make sure production, packaging, and dispatch are completed on time.'],
    ['High Quality Control','We maintain detail so quality control can meet customer needs nationally and globally.']
  ],
  worldwide:'worldwide.',
  worldwideText:'Mahogani Utama Indonesia continues to expand globally and nationally with production capacity and high quality standards. In 2017 we began exporting wooden panels to Europe, followed by Japan and America.',
  projects:'projects.', allProjects:'View All Projects', blog:'blog.', allBlog:'View All Blog', read:'Read article',
  contactTitle:'Contact us',
  contactText:'Find the right solution for your furniture projects. Whether you need custom designs, manufacturing expertise, or quality materials, our team is ready to help bring the project to life.',
  contactCta:'Contact us',
  pageTitles:{about:'About Us',services:'Services',oem:'OEM and ODM Product',interior:'Interior Contractor',commercial:'Home and Commercial',clients:'Clients',blog:'Blog',contact:'Contact Us'},
  vision:'vision.', visionText:'Become a strategic partner in the domestic and foreign interior industry.',
  mission:'mission.', missionItems:['Committed to excellent product quality and service that anticipates trends and comfort needs.','Consistent in product and production processes.'],
  value:'value.', valueItems:[['Integrity','Act responsibly and honestly throughout production and business relationships.'],['Teamwork','Collaborate across teams to deliver consistent project outcomes.'],['Humility','Keep learning, improving processes, and respecting every project stakeholder.']],
  milestone:'milestone.',
  timeline:[['2004','Established','Established with the “Eternity Kitchen” brand and kitchen-set design.'],['2006','Workshop','Opened an in-house workshop in South Jakarta producing kitchen sets and other furniture products.'],['2010','Moved','Moved and expanded the workshop to Depok with an experienced production team.'],['2014','Automation','Equipped production with CNC machines for process automation.'],['2016','Expanded','Expanded the work area from approximately 1,000 m² to 2,000 m².'],['2017','Export to UAE','Began exporting wooden panels to the UAE and Western Europe.'],['2018','Export to Japan','Started exporting wooden panels to Japan.'],['2019','Export to USA','Started exporting cabinetry to the United States.']],
  serviceIntro:'Choose the service route that matches your project requirements.',
  serviceCards:[['OEM / ODM Product','Furniture and cabinetry production around your specification, quantity, material, and quality standard.'],['Interior Contractor','Built-in cabinetry and interior furniture coordinated around production and site requirements.'],['Home & Commercial','Custom furniture for residential, office, retail, hospitality, and commercial spaces.']],
  oemIntro1:'OEM and ODM production is usually more cost-competitive because of economies of scale. Outsourcing to Mahogani can reduce capital costs associated with machinery and factory space.',
  oemIntro2:'Clients can also benefit operationally from production infrastructure and support around fluctuating raw-material costs, helping protect planned budgets.',
  oemBodies:['With quality that meets export requirements, we produce kitchen and wardrobe cabinets using American Standard and Euro Standard references.','With the growth of marketplaces, we provide retail furniture products with good quality and competitive production economics.','Custom and standard office furniture for commercial, local, institutional, and government requirements.','We provide services for producing wood-based products from product-designer concepts and special specifications.'],
  portfolioIntro:'Project imagery from Mahogani’s public portfolio.',
  clientsNote:'There are still many interior contractors and project relationships that cannot be mentioned due to privacy policy.',
  formTitle:'Send Us A Message', name:'Name', emailLabel:'Email Address', phoneLabel:'Phone', scope:'Comments / Questions', send:'Send via WhatsApp', info:'Contact Info', location:'Our Location', email:'Our Email', follow:'Follow Us'
};

const meta = copy.meta[page] ?? copy.meta.home;
const pageImage = page === 'interior' ? interiorGallery[0] : page === 'commercial' ? commercialGallery[0] : page === 'oem' ? assets.heroFallback : page === 'clients' ? assets.quality : page === 'blog' ? assets.service5 : page === 'contact' ? assets.scheduling : assets.factory;
---
<BaseLayout title={meta[0]} description={meta[1]}>
{page === 'home' && <>
  <section class="classic-hero">
    <img class="classic-hero-media" src={assets.hero} alt="Mahogani furniture manufacturing" width="2200" height="1467" fetchpriority="high" decoding="async" />
    <div class="classic-hero-overlay"></div>
    <div class="classic-hero-inner" data-reveal>
      <div class="classic-hero-copy">
        <p class="classic-overline">PT Mahogani Utama Indonesia · Since 2004</p>
        <h1>{copy.heroTitle.split('\n').map((line) => <span>{line}</span>)}</h1>
        <p>{copy.heroSub}</p>
        <div class="classic-actions"><a class="classic-btn primary" href={href('/services/')}>{copy.services}</a><a class="classic-btn ghost" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noreferrer">{copy.contact}</a></div>
      </div>
    </div>
  </section>

  <section class="classic-section classic-about">
    <div class="classic-heading"><span>01</span><h2>{copy.about}</h2></div>
    <div class="classic-about-grid">
      <div class="classic-about-copy" data-reveal><p>{copy.aboutText}</p><a class="classic-text-link" href={href('/about/')}>{isId ? 'Selengkapnya tentang Mahogani' : 'More about Mahogani'} ↗</a></div>
      <div class="classic-about-image" data-reveal><img src={assets.about} alt="Mahogani production facility" width="1400" height="930" loading="lazy" decoding="async" /></div>
    </div>
    <div class="classic-capabilities">
      {copy.capabilities.map(([title,body],i) => <article class="classic-capability" data-reveal><div class="classic-cap-image"><img src={capabilityImages[i]} alt="" width="900" height="650" loading="lazy" decoding="async" /></div><span>0{i+1}</span><h3>{title}</h3><p>{body}</p></article>)}
    </div>
  </section>

  <section class="classic-showcase">
    <div class="classic-showcase-head" data-reveal><p>{copy.see}</p><a href={href('/services/')}>{copy.services} ↗</a></div>
    <div class="classic-showcase-grid">
      <a href={href('/services/oem-and-odm-product/')}><img src={assets.heroFallback} alt="OEM ODM furniture" width="1200" height="850" loading="lazy"/><span>OEM / ODM</span></a>
      <a href={href('/services/interior-contractor/')}><img src={interiorGallery[0]} alt="Interior Contractor" width="1200" height="850" loading="lazy"/><span>{isId?'Kontraktor Interior':'Interior Contractor'}</span></a>
      <a href={href('/services/home-and-commercial/')}><img src={commercialGallery[0]} alt="Home and Commercial" width="1200" height="850" loading="lazy"/><span>{isId?'Hunian & Komersial':'Home & Commercial'}</span></a>
    </div>
  </section>

  <section class="classic-section classic-why">
    <div class="classic-heading"><span>02</span><h2>{copy.why}</h2></div>
    <div class="classic-why-list">{copy.whyItems.map(([title,body],i) => <article class:list={['classic-why-row',{'reverse':i%2===1}]} data-reveal><div class="classic-why-media"><img src={whyImages[i]} alt={title} width="1400" height="930" loading="lazy" decoding="async" /></div><div class="classic-why-copy"><span>0{i+1}</span><h3>{title}</h3><p>{body}</p></div></article>)}</div>
  </section>

  <section class="classic-worldwide"><div class="classic-worldwide-inner" data-reveal><span>03</span><div><h2>{copy.worldwide}</h2><p>{copy.worldwideText}</p><a class="classic-btn ghost light" href={href('/about/')}>{isId?'Lihat perjalanan Mahogani':'See our journey'}</a></div></div></section>

  <section class="classic-section classic-projects">
    <div class="classic-heading split"><div><span>04</span><h2>{copy.projects}</h2></div><a href={href('/clients/')}>{copy.allProjects} ↗</a></div>
    <div class="classic-project-grid">{projects.map((name,i) => <a href={href('/clients/')} class="classic-project" data-reveal><div class="classic-project-img"><img src={selectedProjectImages[i]} alt={name} width="1200" height="900" loading="lazy" decoding="async" /></div><div><span>{String(i+1).padStart(2,'0')}.</span><h3>{name}</h3></div></a>)}</div>
  </section>

  <section class="classic-section classic-blog">
    <div class="classic-heading split"><div><span>05</span><h2>{copy.blog}</h2></div><a href={href('/blog/')}>{copy.allBlog} ↗</a></div>
    <div class="classic-blog-grid">{blogPosts.slice(0,3).map((post) => <a class="classic-post" href={post.href} target="_blank" rel="noreferrer" data-reveal><img src={post.image} alt={post.title} width="900" height="600" loading="lazy" decoding="async"/><small>Mahogani Journal</small><h3>{post.title}</h3><p>{post.excerpt}</p><b>{copy.read} ↗</b></a>)}</div>
  </section>

  <section class="classic-contact-band"><div data-reveal><span>06</span><h2>{copy.contactTitle}</h2><p>{copy.contactText}</p><a class="classic-btn primary" href={href('/contact-us/')}>{copy.contactCta}</a></div></section>
</>}

{page !== 'home' && <>
  <section class="classic-page-hero"><img src={pageImage} alt="" width="1800" height="1100" fetchpriority="high" decoding="async"/><div></div><div class="classic-page-hero-inner"><p>PT Mahogani Utama Indonesia</p><h1>{copy.pageTitles[page]}</h1></div></section>

  {page === 'about' && <>
    <section class="classic-section classic-inner-intro"><div class="classic-heading"><span>01</span><h2>{copy.about}</h2></div><div class="classic-intro-two"><p class="lead">{copy.aboutText}</p><div class="classic-about-image"><img src={assets.about} alt="Mahogani production facility" width="1400" height="930" loading="lazy" decoding="async" /></div></div>
      <div class="classic-capabilities">{copy.capabilities.map(([title,body],i) => <article class="classic-capability" data-reveal><div class="classic-cap-image"><img src={capabilityImages[i]} alt="" width="900" height="650" loading="lazy" decoding="async" /></div><span>0{i+1}</span><h3>{title}</h3><p>{body}</p></article>)}</div>
    </section>
    <section class="classic-section classic-why"><div class="classic-heading"><span>02</span><h2>{copy.why}</h2></div><div class="classic-why-list">{copy.whyItems.map(([title,body],i) => <article class:list={['classic-why-row',{'reverse':i%2===1}]} data-reveal><div class="classic-why-media"><img src={whyImages[i]} alt={title} width="1400" height="930" loading="lazy" decoding="async" /></div><div class="classic-why-copy"><span>0{i+1}</span><h3>{title}</h3><p>{body}</p></div></article>)}</div></section>
    <section class="classic-worldwide"><div class="classic-worldwide-inner" data-reveal><span>03</span><div><h2>{copy.worldwide}</h2><p>{copy.worldwideText}</p></div></div></section>
    <section class="classic-section"><div class="classic-values"><article><span>01</span><h3>{copy.vision}</h3><p>{copy.visionText}</p></article><article><span>02</span><h3>{copy.mission}</h3><ul>{copy.missionItems.map((item) => <li>{item}</li>)}</ul></article></div><div class="classic-heading"><span>04</span><h2>{copy.value}</h2></div><div class="classic-values">{copy.valueItems.map(([title,body],i) => <article><span>0{i+1}</span><h3>{title}</h3><p>{body}</p></article>)}</div></section>
    <section class="classic-section"><div class="classic-heading"><span>05</span><h2>{copy.milestone}</h2></div><div class="classic-timeline">{copy.timeline.map(([year,title,body]) => <div><time>{year}</time><h3>{title}</h3><p>{body}</p></div>)}</div></section>
  </>}

  {page === 'services' && <section class="classic-section"><div class="classic-inner-intro"><p class="lead">{copy.serviceIntro}</p></div><div class="classic-service-list">{copy.serviceCards.map(([title,body],i) => { const paths=['/services/oem-and-odm-product/','/services/interior-contractor/','/services/home-and-commercial/']; const imgs=[assets.heroFallback,interiorGallery[0],commercialGallery[0]]; return <a href={href(paths[i])} class="classic-service-row"><img src={imgs[i]} alt={title} width="1200" height="850" loading="lazy"/><span>0{i+1}</span><div><h2>{title}</h2><p>{body}</p><b>{isId?'Lihat layanan':'View service'} ↗</b></div></a> })}</div></section>}

  {page === 'oem' && <>
    <section class="classic-section classic-inner-intro"><div class="classic-heading"><span>01</span><h2>OEM / ODM</h2></div><div class="classic-intro-two"><p class="lead">{copy.oemIntro1}</p><p>{copy.oemIntro2}</p></div></section>
    {oemGroups.map((group,i) => <section class="classic-product-group"><div class="classic-product-head"><span>0{i+1}</span><div><h2>{group.title}</h2><p>{copy.oemBodies[i]}</p></div></div><div class="classic-product-grid">{group.images.map((src,j)=><figure><img src={src} alt={`${group.title} ${j+1}`} width="1100" height="850" loading="lazy" decoding="async"/><figcaption>{String(j+1).padStart(2,'0')}</figcaption></figure>)}</div></section>)}
  </>}

  {(page === 'interior' || page === 'commercial') && <section class="classic-section"><div class="classic-inner-intro"><div class="classic-heading"><span>01</span><h2>{page === 'interior' ? (isId?'proyek interior.':'interior projects.') : (isId?'hunian & komersial.':'home & commercial.')}</h2></div><p class="lead">{copy.portfolioIntro}</p></div><div class="classic-gallery">{(page==='interior'?interiorGallery:commercialGallery).map((src,i)=><figure data-reveal><img src={src} alt={`${copy.pageTitles[page]} ${i+1}`} width="1200" height="900" loading="lazy" decoding="async"/><figcaption>{String(i+1).padStart(2,'0')}</figcaption></figure>)}</div></section>}

  {page === 'clients' && <section class="classic-section"><div class="classic-inner-intro"><div class="classic-heading"><span>01</span><h2>{isId?'klien.':'clients.'}</h2></div></div><div class="classic-logo-grid">{clientLogos.map(([name,src]) => <div><img src={src} alt={`${name} logo`} width="260" height="120" loading="lazy" decoding="async"/><span>{name}</span></div>)}</div><p class="classic-privacy-note">{copy.clientsNote}</p></section>}

  {page === 'blog' && <section class="classic-section"><div class="classic-blog-grid">{blogPosts.map((post) => <a class="classic-post" href={post.href} target="_blank" rel="noreferrer"><img src={post.image} alt={post.title} width="900" height="600" loading="lazy" decoding="async"/><small>Mahogani Journal</small><h3>{post.title}</h3><p>{post.excerpt}</p><b>{copy.read} ↗</b></a>)}</div></section>}

  {page === 'contact' && <section class="classic-section classic-contact-page"><div class="classic-contact-form"><div class="classic-heading"><span>01</span><h2>{copy.formTitle}</h2></div><form id="classic-contact-form"><label>{copy.name}<input name="name" autocomplete="name" required /></label><label>{copy.emailLabel}<input type="email" name="email" autocomplete="email" required /></label><label>{copy.phoneLabel}<input type="tel" name="phone" autocomplete="tel" /></label><label>{copy.scope}<textarea name="scope" required></textarea></label><button type="submit">{copy.send} ↗</button></form></div><aside class="classic-contact-info"><div class="classic-heading"><span>02</span><h2>{copy.info}</h2></div><div><small>{copy.location}</small><p>{site.factory}</p></div><div><small>{copy.email}</small><p><a href={`mailto:${site.email}`}>{site.email}</a></p></div><div><small>{copy.phoneLabel}</small><p>{site.phone.join(' · ')}<br/><a href={`https://wa.me/${site.whatsapp}`}>+62 877 4760 3739</a></p></div><div><small>{copy.follow}</small><p><a href={site.instagram} target="_blank" rel="noreferrer">Instagram ↗</a></p></div></aside></section>}
  {page === 'contact' && <script is:inline define:vars={{ whatsapp:site.whatsapp, isId }}>
    document.getElementById('classic-contact-form')?.addEventListener('submit',(event)=>{event.preventDefault();const form=new FormData(event.currentTarget);const intro=isId?'Halo Mahogani, saya ingin mendiskusikan proyek.':'Hello Mahogani, I would like to discuss a project.';const labels=isId?['Nama','Email','Telepon','Komentar / Pertanyaan']:['Name','Email','Phone','Comments / Questions'];const msg=[intro,`${labels[0]}: ${form.get('name')||'-'}`,`${labels[1]}: ${form.get('email')||'-'}`,`${labels[2]}: ${form.get('phone')||'-'}`,`${labels[3]}: ${form.get('scope')||'-'}`].join('\n');window.open(`https://wa.me/${whatsapp}?text=${encodeURIComponent(msg)}`,'_blank','noopener,noreferrer');});
  </script>}
</>}
</BaseLayout>