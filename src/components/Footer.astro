---
import { site } from '@/data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (href: string) => `${base}${href}`;
const logo = site.logo.startsWith('/') ? `${base}${site.logo}` : site.logo;
---
<footer class="footer">
  <div class="footer-cta">
    <div class="kicker light">Start with the drawing</div>
    <h2>Have something<br/>to manufacture?</h2>
    <a class="footer-cta-link" href={withBase('/en/contact-us/')}><span>Discuss your project</span><b>↗</b></a>
  </div>
  <div class="footer-grid">
    <div class="footer-brand">
      <span class="footer-logo-crop"><img src={logo} alt="Mahogani Utama Indonesia" /></span>
      <p>Furniture & cabinetry manufacturing, OEM/ODM production and interior project delivery from Indonesia.</p>
    </div>
    <div>
      <span class="label">Factory</span>
      <p>{site.factory}</p>
    </div>
    <div>
      <span class="label">Contact</span>
      <p><a href={`mailto:${site.email}`}>{site.email}</a><br/><a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noreferrer">+62 877 4760 3739</a></p>
    </div>
    <div>
      <span class="label">Navigate</span>
      <p class="footer-links"><a href={withBase('/en/about/')}>About</a><a href={withBase('/en/services/')}>Capabilities</a><a href={withBase('/en/clients/')}>Clients</a><a href={withBase('/en/blog/')}>Journal</a></p>
    </div>
  </div>
  <div class="footer-bottom"><span>© {new Date().getFullYear()} PT Mahogani Utama Indonesia</span><a href={site.instagram} target="_blank" rel="noreferrer">Instagram ↗</a></div>
</footer>
