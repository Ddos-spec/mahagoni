{
  "ci": {
    "collect": {
      "url": [
        "https://ddos-spec.github.io/mahagoni/en/",
        "https://ddos-spec.github.io/mahagoni/en/about/",
        "https://ddos-spec.github.io/mahagoni/en/services/",
        "https://ddos-spec.github.io/mahagoni/en/services/oem-and-odm-product/",
        "https://ddos-spec.github.io/mahagoni/en/services/interior-contractor/",
        "https://ddos-spec.github.io/mahagoni/en/services/home-and-commercial/",
        "https://ddos-spec.github.io/mahagoni/en/clients/",
        "https://ddos-spec.github.io/mahagoni/en/blog/",
        "https://ddos-spec.github.io/mahagoni/en/contact-us/",
        "https://ddos-spec.github.io/mahagoni/id/",
        "https://ddos-spec.github.io/mahagoni/id/about/",
        "https://ddos-spec.github.io/mahagoni/id/services/",
        "https://ddos-spec.github.io/mahagoni/id/services/oem-and-odm-product/",
        "https://ddos-spec.github.io/mahagoni/id/services/interior-contractor/",
        "https://ddos-spec.github.io/mahagoni/id/services/home-and-commercial/",
        "https://ddos-spec.github.io/mahagoni/id/clients/",
        "https://ddos-spec.github.io/mahagoni/id/blog/",
        "https://ddos-spec.github.io/mahagoni/id/contact-us/"
      ],
      "numberOfRuns": 1,
      "settings": {
        "onlyCategories": ["performance", "accessibility", "best-practices", "seo"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 200 }],
        "first-contentful-paint": ["warn", { "maxNumericValue": 1800 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
