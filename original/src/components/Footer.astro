---
import { site } from '@/data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.startsWith(base) ? Astro.url.pathname.slice(base.length) || '/' : Astro.url.pathname;
const isId = path.startsWith('/id/');
const root = isId ? '/id' : '/en';
const withBase = (href:string)=>`${base}${href}`;
const logo = site.logo.startsWith('/') ? `${base}${site.logo}` : site.logo;
const c = isId ? {office:'Kantor',factory:'Pabrik',menu:'Menu',contact:'Hubungi Kami',home:'Beranda',about:'Tentang',services:'Layanan',clients:'Klien',blog:'Artikel',desc:'Manufaktur furnitur dan kabinet, OEM/ODM, kontraktor interior, serta furnitur hunian dan komersial.'} : {office:'Office',factory:'Factory',menu:'Menu',contact:'Contact us',home:'Home',about:'About',services:'Services',clients:'Clients',blog:'Blog',desc:'Furniture and cabinet manufacturing, OEM/ODM, interior contracting, and home or commercial furniture.'};
---
<footer class="footer classic-footer">
  <div class="classic-footer-grid">
    <div class="classic-footer-brand">
      <span class="footer-logo-crop"><img src={logo} width="473" height="129" alt="Mahogani Utama Indonesia" loading="lazy" decoding="async" /></span>
      <p>{c.desc}</p>
      <a href={site.instagram} target="_blank" rel="noreferrer">Instagram ↗</a>
    </div>
    <div><span class="label">{c.office}</span><p>{site.office}</p><span class="label second">{c.factory}</span><p>{site.factory}</p></div>
    <div><span class="label">{c.menu}</span><nav class="classic-footer-links"><a href={withBase(`${root}/`)}>{c.home}</a><a href={withBase(`${root}/about/`)}>{c.about}</a><a href={withBase(`${root}/services/`)}>{c.services}</a><a href={withBase(`${root}/clients/`)}>{c.clients}</a><a href={withBase(`${root}/blog/`)}>{c.blog}</a></nav></div>
    <div><span class="label">{c.contact}</span><p><a href={`tel:${site.phone[0].replace(/[^0-9+]/g,'')}`}>{site.phone[0]}</a><br/><a href={`tel:${site.phone[1].replace(/[^0-9+]/g,'')}`}>{site.phone[1]}</a><br/><a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noreferrer">+62 877 4760 3739</a><br/><a href={`mailto:${site.email}`}>{site.email}</a></p></div>
  </div>
  <div class="footer-bottom"><span>Copyright © {new Date().getFullYear()} Mahogani</span><span>PT Mahogani Utama Indonesia</span></div>
</footer>
