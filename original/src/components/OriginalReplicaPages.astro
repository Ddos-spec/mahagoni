---
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  assets,
  blogPosts,
  clientLogos,
  commercialGallery,
  interiorGallery,
  oemGroups,
  serviceDifferentiators,
  site,
  whyUsGalleries,
  media,
} from '@/data/site';

interface Props { lang: 'en' | 'id'; page: string; }
const { lang, page } = Astro.props;
const isId = lang === 'id';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (path: string) => `${base}/${lang}${path}`;

const projects = [
  ['PT Samsung Indonesia', media('2022/10/COM1B.jpg')],
  ['PappaRich Office', media('2022/10/PAPARICH-OFFICE.jpeg')],
  ['DZ Bank', media('2022/10/DZ-BANK.jpg')],
  ['Yamaha Star Music', media('2022/10/KONT2A.jpg')],
  ['IES Jakarta', media('2022/10/IES-JAKARTA.jpg')],
  ['Bank Mandiri', media('2022/10/KONT8B.jpg')],
] as const;

const copy = isId ? {
  meta: {
    home:['Mahogani Utama Indonesia — Manufaktur Furnitur & Interior','Manufaktur furnitur dan kabinet, OEM/ODM, kontraktor interior, serta furnitur hunian dan komersial.'],
    about:['Tentang — Mahogani Utama Indonesia','Profil, kapabilitas, visi, misi, nilai, dan perjalanan PT Mahogani Utama Indonesia.'],
    services:['Layanan — Mahogani Utama Indonesia','Kapabilitas manufaktur dan layanan Mahogani Utama Indonesia.'],
    oem:['OEM & ODM — Mahogani Utama Indonesia','Produksi OEM dan ODM untuk kitchen cabinet, wardrobe, retail, office, dan special furniture.'],
    interior:['Kontraktor Interior — Mahogani Utama Indonesia','Portofolio kontraktor interior Mahogani Utama Indonesia.'],
    commercial:['Hunian dan Komersial — Mahogani Utama Indonesia','Portofolio furnitur hunian dan komersial Mahogani Utama Indonesia.'],
    clients:['Klien — Mahogani Utama Indonesia','Daftar klien publik Mahogani Utama Indonesia.'],
    blog:['Artikel — Mahogani Utama Indonesia','Artikel material, furnitur, kabinet, dan interior dari Mahogani.'],
    contact:['Hubungi Kami — Mahogani Utama Indonesia','Hubungi Mahogani untuk kebutuhan manufaktur, OEM/ODM, dan proyek interior.'],
  },
  hero:'Visi yang Luas Layanan yang Jujur Nilai yang Luar Biasa',
  sub:'Tujuan kami dulu dan sekarang adalah menyediakan proyek berkualitas dan tepat waktu.',
  services:'Layanan Kami', contact:'Hubungi Kami', about:'tentang.',
  aboutText:'PT Mahogani Utama Indonesia adalah perusahaan manufaktur furnitur/kabinet yang bekerja sama dengan merek furnitur/kabinet, desainer interior, dan kontraktor. Dilengkapi mesin pada industri cabinetry dan tenaga berpengalaman di bidang produksi kabinet.',
  capability:[
    ['PENGOLAHAN KAYU','Kami memiliki sumber daya, kapasitas, dan pengalaman woodworking untuk memenuhi kebutuhan pelanggan saat ini maupun masa depan.'],
    ['OTOMATISASI','Kami memaksimalkan tenaga mesin untuk menghasilkan presisi dan ketepatan waktu.'],
    ['KUALITAS','Kami berkomitmen memberikan layanan manufaktur berkualitas melalui peningkatan berkelanjutan.'],
    ['KAPASITAS BESAR','Sistem kerja yang efektif dan efisien memberi kami kapasitas produksi yang besar.'],
  ],
  see:'Lihat Apa yang Bisa Kami Lakukan', why:'kenapa kami.',
  whyItems:[
    ['Pemesanan dan Kustomisasi yang Mudah','Pemesanan dibuat sederhana dengan opsi kustomisasi yang fleksibel sesuai kebutuhan proyek.'],
    ['Penjadwalan Tepat Waktu','Produksi, pengemasan, dan pengiriman dikoordinasikan agar berjalan tepat waktu.'],
    ['Kontrol Kualitas Tinggi','Setiap detail dijaga agar standar kualitas memenuhi kebutuhan pelanggan nasional dan global.'],
  ],
  worldwide:'di seluruh dunia.',
  worldwideText:'Mahogani Utama Indonesia terus berkembang secara nasional dan global dengan kapasitas produksi serta standar kualitas yang tinggi. Sejak 2017 kami mulai mengekspor panel kayu ke Eropa, kemudian Jepang dan Amerika pada tahun berikutnya.',
  projects:'proyek.', blog:'artikel.', allProjects:'Lihat Semua Proyek', allBlog:'Lihat Semua Artikel', read:'Baca Selengkapnya',
  contactTitle:'Hubungi kami', contactText:'Temukan solusi yang tepat untuk proyek furnitur Anda. Tim kami siap membantu kebutuhan desain khusus, manufaktur, material, dan produksi.',
  titles:{about:'Tentang Kami',services:'Layanan',oem:'OEM dan ODM Product',interior:'Kontraktor Interior',commercial:'Hunian dan Komersial',clients:'Klien',blog:'Artikel',contact:'Hubungi Kami'},
  vision:'visi.', visionText:'Menjadi mitra strategis dalam industri interior domestik dan internasional.',
  mission:'misi.', missionItems:['Berkomitmen pada kualitas produk dan layanan terbaik yang mengantisipasi tren dan kebutuhan kenyamanan.','Konsisten dalam produk dan proses produksi.'],
  values:'nilai.', valueItems:[['Integritas','Menjaga kejujuran dan tanggung jawab dalam proses kerja dan hubungan bisnis.'],['Kerja Sama Tim','Mendorong kolaborasi yang kuat untuk menghasilkan pekerjaan yang konsisten.'],['Kerendahan Hati','Terus belajar, memperbaiki proses, dan menghargai setiap pihak dalam proyek.']],
  milestones:'pencapaian.',
  timeline:[['2004','Didirikan','Didirikan dengan merek Eternity Kitchen dan layanan desain kitchen set.'],['2006','Workshop','Mendirikan workshop internal di Jakarta Selatan.'],['2010','Pindah','Memindahkan dan memperluas workshop ke Depok dengan tim produksi berpengalaman.'],['2014','Otomatisasi','Menggunakan mesin CNC untuk otomatisasi proses produksi.'],['2016','Diperluas','Memperluas area kerja dari sekitar 1.000 m² menjadi 2.000 m².'],['2017','Ekspor','Mulai mengekspor panel kayu ke UEA dan Eropa Barat.'],['2018','Jepang','Mulai mengekspor panel kayu ke Jepang.'],['2019','Amerika Serikat','Mulai mengekspor cabinetry ke Amerika Serikat.']],
  serviceLead:'Kami terus berkembang dari satu kekuatan ke kekuatan berikutnya, menjadikan kami mitra yang tepat untuk berbagai kebutuhan manufaktur woodworking.',
  diff:'Kami membedakan diri melalui:', diffItems:['Otomatisasi','Tepat Jadwal','Presisi','Harga','Kualitas','Desain Kustom','Kapasitas','Ekspor'],
  portfolio:'Portofolio proyek dari arsip asli Mahogani.', privacy:'Masih terdapat banyak kontraktor interior dan hubungan proyek lain yang tidak dapat disebutkan karena kebijakan privasi.',
  form:'Kirimkan Pesan Kepada Kami', order:'Nomor Pesanan', name:'Nama', email:'Alamat Email', question:'Komentar / Pertanyaan', send:'Kirim', info:'Info Kontak', location:'Lokasi Kami', ourEmail:'Email Kami', follow:'Ikuti Kami',
  clientLabel:'Klien',
} : {
  meta: {
    home:['Furniture Manufacturer, Office and School Furniture Manufacturer','PT Mahogani Utama Indonesia is furniture/cabinetry and office furniture manufacturing that cooperates with furniture/cabinet brands, interior consultant, contractors also any foreign and local companies.'],
    about:['About - Mahogani','About PT Mahogani Utama Indonesia, our manufacturing capability, vision, mission, values, and milestone.'],
    services:['Services - Mahogani','Mahogani manufacturing services, differentiation, and global capability.'],
    oem:['OEM And ODM Product - Mahogani','OEM and ODM furniture production by PT Mahogani Utama Indonesia.'],
    interior:['Interior Contractor - Mahogani','Interior Contractor'],
    commercial:['Home and Commercial - Mahogani','Home and Commercial'],
    clients:['Clients - Mahogani','Clients and there are still many interior contractors that cannot be mentioned due to the privacy Policy'],
    blog:['Blog - Mahogani','Furniture, cabinetry and interior articles from Mahogani.'],
    contact:['Contact Us - Mahogani','Contact Mahogani for furniture manufacturing, OEM/ODM, and interior requirements.'],
  },
  hero:'Broad Vision Honest Service Great Value',
  sub:'Our goal then and now is to provide quality on time projects',
  services:'Our Services', contact:'Contact Us', about:'about.',
  aboutText:'PT Mahogani Utama Indonesia is a furniture/cabinet manufacturing company that cooperates with furniture/cabinet brands, interior designer, and also contractors. Equipped with the latest machinery in the cabinetry industry and full with experts in the field of cabinet production.',
  capability:[
    ['WOOD WORKING','We have necessary resource, capacity and experience in wood working, meet current and future customer requirements.'],
    ['AUTOMATION','We maximize machine power to produce precision and timeliness.'],
    ['QUALITY','We are committed to constantly providing quality manufacturing service through continuous improvement.'],
    ['LARGE CAPACITY','An effective and efficient working system gives us a large production capacity.'],
  ],
  see:'See What We Can Do', why:'why us.',
  whyItems:[['Easy Ordering and Customization','Place orders easily and personalize specifications with flexible customization options.'],['On-time Scheduling','Production, packaging, and dispatch are coordinated to stay on schedule.'],['High Quality Control','We maintain every detail so quality control can meet national and global customer requirements.']],
  worldwide:'worldwide.',
  worldwideText:'Mahogani Utama Indonesia continues to expand globally and nationally with production capacity as well as highest standard quality. At 2017 we began to exporting wooden panels to Europe, then followed by export to Japan and America in the next year.',
  projects:'projects.', blog:'blog.', allProjects:'View All Projects', allBlog:'View All Blog', read:'Read More',
  contactTitle:'Contact us', contactText:'Find the right solution for your furniture project. Our team is ready to support custom design, manufacturing, material, and production requirements.',
  titles:{about:'About Us',services:'Services',oem:'OEM and ODM Product',interior:'Interior Contractor',commercial:'Home and Commercial',clients:'Clients',blog:'Blog',contact:'Contact Us'},
  vision:'vision.', visionText:'Become a strategic partner in the domestic and foreign interior industry',
  mission:'mission.', missionItems:['Committed to excellent product quality and service that anticipates trends and comfort needs.','Consistent in product and production processes.'],
  values:'value.', valueItems:[['Intergrity','Act responsibly and honestly throughout production and business relationships.'],['Teamwork','Collaborate across teams to deliver consistent project outcomes.'],['Humility','Keep learning, improving processes, and respecting every project stakeholder.']],
  milestones:'milestone.',
  timeline:[['2004','Established','Established with the Eternity Kitchen brand and kitchen-set design.'],['2006','Workshop','Opened an in-house workshop in South Jakarta.'],['2010','Moved','Moved and expanded the workshop to Depok with an experienced production team.'],['2014','Automation','Equipped production with CNC machines for process automation.'],['2016','Expanded','Expanded the work area from approximately 1,000 m² to 2,000 m².'],['2017','Export','Began exporting wooden panels to the UAE and Western Europe.'],['2018','Japan','Started exporting wooden panels to Japan.'],['2019','United States','Started exporting cabinetry to the United States.']],
  serviceLead:'We go from strength to strength; making us the right partner for any wood working manufacture requirements.',
  diff:'We differentiate ourselves through the following:', diffItems:[...serviceDifferentiators],
  portfolio:'Project imagery from Mahogani’s original public portfolio.', privacy:'and there are still many interior contractors that cannot be mentioned due to the privacy Policy',
  form:'Send Us A Message', order:'Order Number', name:'Name', email:'Email Address', question:'Comments / Questions', send:'Submit', info:'Contact Info', location:'Our Location', ourEmail:'Our Email', follow:'Follow Us',
  clientLabel:'Clients',
};

const meta = copy.meta[page] ?? copy.meta.home;
const pageImage = page === 'about' ? assets.hero : assets.internalHero;
const homePosts = blogPosts.slice(0, 3);
const gallery = page === 'interior' ? interiorGallery : commercialGallery;
---
<BaseLayout title={meta[0]} description={meta[1]} image={pageImage}>
  {page === 'home' && <>
    <section class="orig-hero">
      <img src={assets.banner} alt="Mahogani furniture manufacturing" width="1920" height="1080" fetchpriority="high" decoding="async" />
      <div class="orig-hero-shade"></div>
      <div class="orig-wrap orig-hero-copy" data-reveal>
        <h1>{copy.hero}</h1>
        <p>{copy.sub}</p>
        <div class="orig-actions"><a class="orig-btn orange" href={href('/services/')}>{copy.services}</a><a class="orig-btn light" href={href('/contact-us/')}>{copy.contact}</a></div>
      </div>
    </section>

    <section class="orig-about orig-wrap">
      <h2 class="orig-section-title">{copy.about}</h2>
      <p class="orig-about-lead">{copy.aboutText}</p>
      <div class="orig-capability-layout">
        <div class="orig-capability-list">{copy.capability.map(([title,body],i)=><article class="orig-capability" data-reveal><img src={assets.capabilities[i]} alt="" width="458" height="458" loading="lazy"/><div><h3>{title}</h3><p>{body}</p></div></article>)}</div>
        <div class="orig-factory-photo" data-reveal><img src={assets.hero} alt="Mahogani production" width="1600" height="1035" loading="lazy"/></div>
      </div>
    </section>

    <section class="orig-video" style={`--orig-video:url('${assets.video}')`}><div class="orig-video-shade"></div><div class="orig-video-inner"><h2>{copy.see}</h2><a href="https://www.youtube.com/watch?v=TYadM1PhQmo" target="_blank" rel="noreferrer" aria-label={copy.see}><span>▶</span></a></div></section>

    <section class="orig-why orig-wrap">
      <h2 class="orig-section-title">{copy.why}</h2>
      {copy.whyItems.map(([title,body],i)=><article class="orig-why-block" data-reveal><div class="orig-why-head"><div><h3>{title}</h3><p>{body}</p></div></div><div class="orig-slider" data-slider data-autoplay="true"><button class="slider-arrow prev" type="button" aria-label="Previous">‹</button><div class="orig-slider-viewport"><div class="orig-slider-track">{whyUsGalleries[i].map((src,j)=><figure class="orig-slide"><img src={src} alt={`${title} ${j+1}`} width="1400" height="930" loading="lazy"/></figure>)}</div></div><button class="slider-arrow next" type="button" aria-label="Next">›</button><div class="slider-dots" aria-hidden="true"></div></div></article>)}
    </section>

    <section class="orig-worldwide orig-wrap"><div class="orig-worldwide-art"><img src={assets.worldwide} alt="" width="677" height="369" loading="lazy"/></div><div><h2 class="orig-section-title">{copy.worldwide}</h2><p>{copy.worldwideText}</p></div></section>

    <section class="orig-projects"><div class="orig-wrap orig-section-head"><h2 class="orig-section-title">{copy.projects}</h2><a href={href('/clients/')}>{copy.allProjects} ↗</a></div><div class="orig-project-grid">{projects.map(([name,img],i)=><a href={href('/clients/')} class="orig-project" style={`--project:url('${img}')`}><span>{String(i+1).padStart(2,'0')}</span><h3>{name}</h3></a>)}</div></section>

    <section class="orig-blog orig-wrap"><div class="orig-section-head"><h2 class="orig-section-title">{copy.blog}</h2><a href={href('/blog/')}>{copy.allBlog} ↗</a></div><div class="orig-home-blog-grid">{homePosts.map((post)=><a class="orig-home-post" href={post.href} target="_blank" rel="noreferrer"><img src={post.image} alt={post.title} width="640" height="426" loading="lazy"/><h3>{post.title}</h3><span>{copy.read} »</span></a>)}</div></section>

    <section class="orig-cta orig-wrap"><div><h2>{copy.contactTitle}</h2><p>{copy.contactText}</p></div><a class="orig-btn white" href={href('/contact-us/')}>{copy.contact} ↗</a></section>
  </>}

  {page !== 'home' && <>
    <section class:list={['orig-page-hero', {'is-about': page === 'about'}]}>
      <img src={pageImage} alt="" width="1800" height="1100" fetchpriority="high" decoding="async"/>
      <div class="orig-page-overlay"></div><div class="orig-wrap"><h1>{copy.titles[page]}</h1></div>
    </section>

    {page === 'about' && <>
      <section class="orig-about orig-wrap"><h2 class="orig-section-title">{copy.about}</h2><p class="orig-about-lead">{copy.aboutText}</p><div class="orig-capability-layout"><div class="orig-capability-list">{copy.capability.map(([title,body],i)=><article class="orig-capability"><img src={assets.capabilities[i]} alt="" width="458" height="458" loading="lazy"/><div><h3>{title}</h3><p>{body}</p></div></article>)}</div><div class="orig-factory-photo"><img src={assets.hero} alt="Mahogani production" width="1600" height="1035" loading="lazy"/></div></div></section>
      <section class="orig-why orig-wrap"><h2 class="orig-section-title">{copy.why}</h2>{copy.whyItems.map(([title,body],i)=><article class="orig-why-block"><div class="orig-why-head"><div><h3>{title}</h3><p>{body}</p></div></div><div class="orig-slider" data-slider><button class="slider-arrow prev" type="button" aria-label="Previous">‹</button><div class="orig-slider-viewport"><div class="orig-slider-track">{whyUsGalleries[i].map((src,j)=><figure class="orig-slide"><img src={src} alt={`${title} ${j+1}`} width="1400" height="930" loading="lazy"/></figure>)}</div></div><button class="slider-arrow next" type="button" aria-label="Next">›</button><div class="slider-dots" aria-hidden="true"></div></div></article>)}</section>
      <section class="orig-worldwide orig-wrap"><div class="orig-worldwide-art"><img src={assets.worldwide} alt="" width="677" height="369" loading="lazy"/></div><div><h2 class="orig-section-title">{copy.worldwide}</h2><p>{copy.worldwideText}</p></div></section>
      <section class="orig-values orig-wrap"><article><h2>{copy.vision}</h2><p>{copy.visionText}</p></article><article><h2>{copy.mission}</h2><ul>{copy.missionItems.map((item)=><li>{item}</li>)}</ul></article></section>
      <section class="orig-wrap orig-value-section"><h2 class="orig-section-title">{copy.values}</h2><div class="orig-value-grid">{copy.valueItems.map(([title,body],i)=><article><img src={assets.values[i]} alt="" width="300" height="300" loading="lazy"/><h3>{title}</h3><p>{body}</p></article>)}</div></section>
      <section class="orig-wrap orig-milestones"><h2 class="orig-section-title">{copy.milestones}</h2><div>{copy.timeline.map(([year,title,body])=><article><time>{year}</time><h3>{title}</h3><p>{body}</p></article>)}</div></section>
    </>}

    {page === 'services' && <>
      <section class="orig-wrap orig-service-intro"><p class="orig-service-lead">{copy.serviceLead}<br/>{copy.diff}</p><div class="orig-diff-grid">{copy.diffItems.map((item)=><div><strong>{item}</strong></div>)}</div></section>
      <section class="orig-worldwide orig-wrap orig-services-worldwide"><div class="orig-worldwide-art"><img src={assets.worldwide} alt="" width="677" height="369" loading="lazy"/></div><div><h2 class="orig-section-title">{copy.worldwide}</h2><p>{copy.worldwideText}</p></div></section>
      <section class="orig-service-cards orig-wrap">{[[isId?'Produk OEM / ODM':'OEM / ODM Product',oemGroups[0].images[0],'/services/oem-and-odm-product/'],[isId?'Kontraktor Interior':'Interior Contractor',interiorGallery[0],'/services/interior-contractor/'],[isId?'Hunian & Komersial':'Home and Commercial',commercialGallery[0],'/services/home-and-commercial/']].map(([title,img,path])=><a href={href(path)}><img src={img} alt={title} width="1400" height="930" loading="lazy"/><h2>{title}</h2></a>)}</section>
    </>}

    {page === 'oem' && <section class="orig-wrap orig-oem-page"><div class="orig-oem-copy"><p>{isId?'Produksi OEM dan ODM umumnya lebih kompetitif karena skala ekonomi. Ketika produksi dialihdayakan kepada kami, perusahaan dapat menghemat belanja modal untuk mesin dan ruang pabrik serta mendapat fleksibilitas biaya operasional dan kapasitas produksi.':'OEM and ODM production is usually more cost-competitive because of the economies of scale and when you choose to outsource to us, it will enable your company to save on capital costs spent on acquiring machinery and factory space. You will also benefit from operational expenses such as buffering against the risks of machine breakdown and changing capacity requirements.'}</p></div>{oemGroups.map((group)=><article class="orig-oem-row"><div class="orig-oem-row-copy"><h3>{group.title}</h3><p>{group.body}</p></div><div class="orig-slider oem-slider" data-slider data-autoplay="true"><button class="slider-arrow prev" type="button" aria-label="Previous">‹</button><div class="orig-slider-viewport"><div class="orig-slider-track">{group.images.map((img,j)=><figure class="orig-slide"><button type="button" class="lightbox-trigger" data-lightbox-src={img} data-lightbox-group={`oem-${group.title}`} aria-label={`${group.title} ${j+1}`}><img src={img} alt={`${group.title} ${j+1}`} width="1400" height="1000" loading="lazy"/></button></figure>)}</div></div><button class="slider-arrow next" type="button" aria-label="Next">›</button><div class="slider-dots" aria-hidden="true"></div></div></article>)}</section>}

    {(page === 'interior' || page === 'commercial') && <section class="orig-wrap orig-gallery-page"><div class="orig-gallery-4">{gallery.map((img,i)=><figure><button type="button" class="lightbox-trigger" data-lightbox-src={img} data-lightbox-group={page} aria-label={`${copy.titles[page]} ${i+1}`}><img src={img} alt={`${copy.titles[page]} ${i+1}`} width="1080" height="720" loading={i<4?'eager':'lazy'} decoding="async"/></button></figure>)}</div></section>}

    {page === 'clients' && <section class="orig-wrap orig-clients"><div class="orig-logo-grid">{clientLogos.map(([name,img])=><figure><img src={img} alt={`${name} logo`} width="300" height="169" loading="lazy" decoding="async"/></figure>)}</div><p class="orig-privacy">{copy.privacy}</p></section>}

    {page === 'blog' && <section class="orig-wrap orig-blog-archive">{blogPosts.map((post)=><article class="orig-archive-post"><a class="orig-archive-image" href={post.href} target="_blank" rel="noreferrer"><img src={post.image} alt={post.title} width="640" height="426" loading="lazy"/></a><h2><a href={post.href} target="_blank" rel="noreferrer">{post.title}</a></h2><div class="orig-post-meta"><span>{isId?'Tinggalkan Komentar':post.comments}</span><span>/</span><span>{post.category}</span><span>/</span><span>{post.author}</span></div><p>{post.excerpt}</p><a class="orig-read-more" href={post.href} target="_blank" rel="noreferrer">{copy.read} »</a></article>)}</section>}

    {page === 'contact' && <section class="orig-wrap orig-contact"><div><h2 class="orig-section-title">{copy.form}</h2><form id="orig-contact-form"><label>{copy.order}<input name="order" autocomplete="off"/></label><label>{copy.name} *<input name="name" autocomplete="name" required/></label><label>{copy.email} *<input type="email" name="email" autocomplete="email" required/></label><label>{copy.question} *<textarea name="scope" required></textarea></label><button type="submit">{copy.send}</button></form></div><aside><h2 class="orig-section-title">{copy.info}</h2><div><small>{copy.location}</small><p>{site.factory}</p></div><div><small>{copy.ourEmail}</small><p><a href={`mailto:${site.legacyEmail}`}>{site.legacyEmail}</a><br/><a href={`mailto:${site.email}`}>{site.email}</a></p></div><div><small>{copy.follow}</small><div class="orig-socials"><span>Facebook</span><span>Twitter</span><span>Google+</span><span>LinkedIn</span><a href={site.instagram} target="_blank" rel="noreferrer">Instagram</a></div></div></aside></section>}
  </>}

  <dialog class="orig-lightbox" data-lightbox-dialog><button class="lightbox-close" type="button" aria-label="Close">×</button><button class="lightbox-nav prev" type="button" aria-label="Previous">‹</button><img src="" alt=""/><button class="lightbox-nav next" type="button" aria-label="Next">›</button></dialog>
</BaseLayout>

<script is:inline>
  (() => {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll('[data-slider]').forEach((slider) => {
      const track = slider.querySelector('.orig-slider-track');
      const slides = Array.from(slider.querySelectorAll('.orig-slide'));
      const prev = slider.querySelector('.slider-arrow.prev');
      const next = slider.querySelector('.slider-arrow.next');
      const dots = slider.querySelector('.slider-dots');
      if (!track || slides.length < 2) return;
      let index = 0;
      const visible = () => window.innerWidth <= 767 ? 1 : window.innerWidth <= 1024 ? 2 : 3;
      const pages = () => Math.max(1, slides.length - visible() + 1);
      const renderDots = () => {
        if (!dots) return;
        dots.innerHTML = '';
        for (let i = 0; i < pages(); i++) {
          const dot = document.createElement('button'); dot.type='button'; dot.tabIndex=-1; dot.className=i===index?'active':'';
          dot.addEventListener('click',()=>{index=i; update();}); dots.appendChild(dot);
        }
      };
      const update = () => {
        index = Math.max(0, Math.min(index, pages()-1));
        const gap = 20;
        const width = slider.querySelector('.orig-slider-viewport')?.clientWidth || 0;
        const card = (width - gap * (visible()-1)) / visible();
        track.style.transform = `translate3d(${-index * (card + gap)}px,0,0)`;
        renderDots();
      };
      prev?.addEventListener('click',()=>{ index = index <= 0 ? pages()-1 : index-1; update(); });
      next?.addEventListener('click',()=>{ index = index >= pages()-1 ? 0 : index+1; update(); });
      window.addEventListener('resize', update, {passive:true});
      update();
      if (slider.getAttribute('data-autoplay') === 'true' && !reduced) {
        let timer = setInterval(()=>{index=index>=pages()-1?0:index+1;update();},5000);
        slider.addEventListener('mouseenter',()=>clearInterval(timer));
      }
    });

    const dialog = document.querySelector('[data-lightbox-dialog]');
    if (dialog instanceof HTMLDialogElement) {
      const image = dialog.querySelector('img');
      let group = []; let current = 0;
      const render = () => { if (image && group[current]) image.src = group[current]; };
      document.querySelectorAll('.lightbox-trigger').forEach((trigger) => trigger.addEventListener('click', () => {
        const name = trigger.getAttribute('data-lightbox-group');
        const triggers = Array.from(document.querySelectorAll(`.lightbox-trigger[data-lightbox-group="${CSS.escape(name || '')}"]`));
        group = triggers.map((el)=>el.getAttribute('data-lightbox-src')).filter(Boolean);
        current = Math.max(0, triggers.indexOf(trigger)); render(); dialog.showModal();
      }));
      dialog.querySelector('.lightbox-close')?.addEventListener('click',()=>dialog.close());
      dialog.querySelector('.lightbox-nav.prev')?.addEventListener('click',()=>{current=(current-1+group.length)%group.length;render();});
      dialog.querySelector('.lightbox-nav.next')?.addEventListener('click',()=>{current=(current+1)%group.length;render();});
      dialog.addEventListener('click',(e)=>{if(e.target===dialog)dialog.close();});
      document.addEventListener('keydown',(e)=>{if(!dialog.open)return;if(e.key==='ArrowLeft'){current=(current-1+group.length)%group.length;render();}if(e.key==='ArrowRight'){current=(current+1)%group.length;render();}});
    }

    const form = document.querySelector('#orig-contact-form');
    form?.addEventListener('submit',(event)=>{
      event.preventDefault();
      const data = new FormData(form);
      const text = [
        'Mahogani website inquiry',
        `Order: ${data.get('order') || '-'}`,
        `Name: ${data.get('name') || '-'}`,
        `Email: ${data.get('email') || '-'}`,
        `Message: ${data.get('scope') || '-'}`,
      ].join('\n');
      window.open(`https://wa.me/6287747603739?text=${encodeURIComponent(text)}`,'_blank','noopener,noreferrer');
    });
  })();
</script>
