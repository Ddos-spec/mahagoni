---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { blogPosts, clientLogos, commercialGallery, interiorGallery, media, oemGroups, serviceDifferentiators, site, whyUsGalleries } from '@/data/site';
interface Props { lang: 'en' | 'id'; page: string; }
const { lang, page } = Astro.props;
const isId = lang === 'id';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (path: string) => `${base}/${lang}${path}`;
const source = {
  banner: media('2022/09/banner.jpg', 2200),
  factory: media('2022/09/MAHOGANI_COMPRO-DETAIL_by-Priambodoyusuf-4.jpg', 1600),
  video: media('2022/09/MAHOGANI_COMPROFILE_by-Priambodoyusuf-2.jpg', 2200),
  worldwide: media('2022/09/why-us-removebg-preview.png', 1000),
  capabilities: [1,2,3,4].map((n) => media(`2022/09/about-icon-${n}-removebg-preview.png`, 520)),
  projects: [media('2022/10/COM1B.jpg',1500),media('2022/10/PAPARICH-OFFICE.jpeg',1500),media('2022/10/DZ-BANK.jpg',1500),media('2022/10/KONT2A.jpg',1500),media('2022/10/IES-JAKARTA.jpg',1500),media('2022/10/KONT8B.jpg',1500)]
};
const projectNames=['PT Samsung Indonesia','PappaRich Office','DZ Bank','Yamaha Star Music','IES Jakarta','Bank Mandiri'];
const copy=isId?{
 meta:{home:['Mahogani Utama Indonesia — Manufaktur Furnitur & Interior','Manufaktur furnitur dan kabinet, OEM/ODM, kontraktor interior, serta furnitur hunian dan komersial.'],about:['Tentang — Mahogani Utama Indonesia','Profil, kapabilitas, visi, misi, nilai, dan perjalanan PT Mahogani Utama Indonesia.'],services:['Layanan — Mahogani Utama Indonesia','Kapabilitas manufaktur dan layanan Mahogani Utama Indonesia.'],oem:['OEM & ODM — Mahogani Utama Indonesia','Produksi OEM dan ODM untuk kitchen cabinet, wardrobe, retail, office, dan special furniture.'],interior:['Kontraktor Interior — Mahogani Utama Indonesia','Portofolio kontraktor interior Mahogani Utama Indonesia.'],commercial:['Hunian & Komersial — Mahogani Utama Indonesia','Portofolio furnitur hunian dan komersial Mahogani Utama Indonesia.'],clients:['Klien — Mahogani Utama Indonesia','Daftar klien publik Mahogani Utama Indonesia.'],blog:['Artikel — Mahogani Utama Indonesia','Artikel material, furnitur, kabinet, dan interior dari Mahogani.'],contact:['Hubungi Kami — Mahogani Utama Indonesia','Hubungi Mahogani untuk kebutuhan manufaktur, OEM/ODM, dan proyek interior.']},
 hero:'Visi yang Luas\nLayanan yang Jujur\nNilai yang Luar Biasa',sub:'Tujuan kami dulu dan sekarang adalah menyediakan proyek berkualitas dan tepat waktu.',services:'Layanan Kami',contact:'Hubungi Kami',about:'tentang.',aboutText:'PT Mahogani Utama Indonesia adalah perusahaan manufaktur furnitur/kabinet yang bekerja sama dengan merek furnitur/kabinet, desainer interior, dan kontraktor. Dilengkapi mesin pada industri cabinetry dan tenaga berpengalaman di bidang produksi kabinet.',capability:[['PENGOLAHAN KAYU','Kami memiliki sumber daya, kapasitas, dan pengalaman woodworking untuk memenuhi kebutuhan pelanggan saat ini maupun masa depan.'],['OTOMATISASI','Kami memaksimalkan tenaga mesin untuk menghasilkan presisi dan ketepatan waktu.'],['KUALITAS','Kami berkomitmen memberikan layanan manufaktur berkualitas melalui peningkatan berkelanjutan.'],['KAPASITAS BESAR','Sistem kerja yang efektif dan efisien memberi kami kapasitas produksi yang besar.']],see:'Lihat Apa yang Bisa Kami Lakukan',why:'kenapa kami.',whyItems:[['Pemesanan dan Kustomisasi yang Mudah','Pemesanan dibuat sederhana dengan opsi kustomisasi yang fleksibel sesuai kebutuhan proyek.'],['Penjadwalan Tepat Waktu','Produksi, pengemasan, dan pengiriman dikoordinasikan agar berjalan tepat waktu.'],['Kontrol Kualitas Tinggi','Setiap detail dijaga agar standar kualitas memenuhi kebutuhan pelanggan nasional dan global.']],worldwide:'di seluruh dunia.',worldwideText:'Mahogani Utama Indonesia terus berkembang secara nasional dan global dengan kapasitas produksi serta standar kualitas yang tinggi. Sejak 2017 kami mulai mengekspor panel kayu ke Eropa, kemudian Jepang dan Amerika.',projects:'proyek.',blog:'artikel.',allProjects:'Lihat Semua Proyek',allBlog:'Lihat Semua Artikel',read:'Baca artikel',load:'Muat Lebih Banyak',contactTitle:'Hubungi kami',contactText:'Temukan solusi yang tepat untuk proyek furnitur Anda. Tim kami siap membantu kebutuhan desain khusus, manufaktur, material, dan produksi.',titles:{about:'Tentang',services:'Layanan',oem:'OEM dan ODM Product',interior:'Kontraktor Interior',commercial:'Hunian dan Komersial',clients:'Klien',blog:'Artikel',contact:'Hubungi Kami'},vision:'visi.',visionText:'Menjadi mitra strategis dalam industri interior domestik dan internasional.',mission:'misi.',missionItems:['Berkomitmen pada kualitas produk dan layanan terbaik yang mengantisipasi tren dan kebutuhan kenyamanan.','Konsisten dalam produk dan proses produksi.'],values:'nilai.',valueItems:[['Integritas','Menjaga kejujuran dan tanggung jawab dalam proses kerja dan hubungan bisnis.'],['Kerja Sama Tim','Mendorong kolaborasi yang kuat untuk menghasilkan pekerjaan yang konsisten.'],['Kerendahan Hati','Terus belajar, memperbaiki proses, dan menghargai setiap pihak dalam proyek.']],milestones:'pencapaian.',timeline:[['2004','Didirikan','Didirikan dengan merek Eternity Kitchen dan layanan desain kitchen set.'],['2006','Workshop','Mendirikan workshop internal di Jakarta Selatan.'],['2010','Pindah','Memindahkan dan memperluas workshop ke Depok dengan tim produksi berpengalaman.'],['2014','Otomatisasi','Menggunakan mesin CNC untuk otomatisasi proses produksi.'],['2016','Diperluas','Memperluas area kerja dari sekitar 1.000 m² menjadi 2.000 m².'],['2017','Ekspor','Mulai mengekspor panel kayu ke UEA dan Eropa Barat.'],['2018','Jepang','Mulai mengekspor panel kayu ke Jepang.'],['2019','Amerika Serikat','Mulai mengekspor cabinetry ke Amerika Serikat.']],strength:'kekuatan kami.',serviceLead:'Kami terus memperkuat kapabilitas agar menjadi mitra yang tepat untuk berbagai kebutuhan manufaktur woodworking.',diff:'Kami membedakan diri melalui:',diffItems:['Otomatisasi','Tepat Jadwal','Presisi','Harga','Kualitas','Desain Kustom','Kapasitas','Ekspor'],oemLead:'Produksi OEM dan ODM memberi akses pada fasilitas, mesin, tenaga produksi, dan skala tanpa menanggung seluruh investasi pabrik secara internal.',oemLead2:'Model ini membantu efisiensi modal, fleksibilitas kapasitas, dan pengendalian rencana produksi.',portfolio:'Portofolio proyek dari arsip publik Mahogani.',privacy:'Masih terdapat hubungan proyek lain yang tidak dapat disebutkan karena kebijakan privasi.',form:'Kirimkan Pesan Kepada Kami',name:'Nama',email:'Alamat Email',phone:'Telepon',question:'Komentar / Pertanyaan',send:'Kirim melalui WhatsApp',info:'Info Kontak',location:'Lokasi Kami',ourEmail:'Email Kami',follow:'Ikuti Kami'
}:{
 meta:{home:['Mahogani Utama Indonesia — Furniture Manufacturer & Interior','Furniture and cabinet manufacturing, OEM/ODM, interior contracting, and home or commercial furniture.'],about:['About — Mahogani Utama Indonesia','Profile, capabilities, vision, mission, values, and milestones of PT Mahogani Utama Indonesia.'],services:['Services — Mahogani Utama Indonesia','Manufacturing capabilities and services of Mahogani Utama Indonesia.'],oem:['OEM & ODM — Mahogani Utama Indonesia','OEM and ODM production for kitchen cabinets, wardrobes, retail, office, and special furniture.'],interior:['Interior Contractor — Mahogani Utama Indonesia','Interior contractor portfolio by Mahogani Utama Indonesia.'],commercial:['Home and Commercial — Mahogani Utama Indonesia','Home and commercial furniture portfolio by Mahogani Utama Indonesia.'],clients:['Clients — Mahogani Utama Indonesia','Public client list of Mahogani Utama Indonesia.'],blog:['Blog — Mahogani Utama Indonesia','Furniture, materials, cabinetry, and interior articles from Mahogani.'],contact:['Contact Us — Mahogani Utama Indonesia','Contact Mahogani for manufacturing, OEM/ODM, and interior projects.']},
 hero:'Broad Vision\nHonest Service\nGreat Value',sub:'Our goal then and now is to provide quality, on-time projects.',services:'Our Services',contact:'Contact Us',about:'about.',aboutText:'PT Mahogani Utama Indonesia is a furniture/cabinet manufacturing company that cooperates with furniture/cabinet brands, interior designers, and contractors. Equipped with machinery in the cabinetry industry and experienced people in cabinet production.',capability:[['WOOD WORKING','We have the necessary resources, capacity, and woodworking experience to meet current and future customer requirements.'],['AUTOMATION','We maximize machine power to produce precision and timeliness.'],['QUALITY','We are committed to constantly providing quality manufacturing service through continuous improvement.'],['LARGE CAPACITY','An effective and efficient working system gives us a large production capacity.']],see:'See What We Can Do',why:'why us.',whyItems:[['Easy Ordering and Customization','Place orders easily and personalize specifications with flexible customization options.'],['On-time Scheduling','Production, packaging, and dispatch are coordinated to stay on schedule.'],['High Quality Control','We maintain every detail so quality control can meet national and global customer requirements.']],worldwide:'worldwide.',worldwideText:'Mahogani Utama Indonesia continues to expand globally and nationally with production capacity and high quality standards. Since 2017 we have exported wooden panels to Europe, followed by Japan and America.',projects:'projects.',blog:'blog.',allProjects:'View All Projects',allBlog:'View All Blog',read:'Read article',load:'Load More',contactTitle:'Contact us',contactText:'Find the right solution for your furniture project. Our team is ready to support custom design, manufacturing, material, and production requirements.',titles:{about:'About Us',services:'Services',oem:'OEM and ODM Product',interior:'Interior Contractor',commercial:'Home and Commercial',clients:'Clients',blog:'Blog',contact:'Contact Us'},vision:'vision.',visionText:'Become a strategic partner in the domestic and foreign interior industry.',mission:'mission.',missionItems:['Committed to excellent product quality and service that anticipates trends and comfort needs.','Consistent in product and production processes.'],values:'value.',valueItems:[['Integrity','Act responsibly and honestly throughout production and business relationships.'],['Teamwork','Collaborate across teams to deliver consistent project outcomes.'],['Humility','Keep learning, improving processes, and respecting every project stakeholder.']],milestones:'milestone.',timeline:[['2004','Established','Established with the Eternity Kitchen brand and kitchen-set design.'],['2006','Workshop','Opened an in-house workshop in South Jakarta.'],['2010','Moved','Moved and expanded the workshop to Depok with an experienced production team.'],['2014','Automation','Equipped production with CNC machines for process automation.'],['2016','Expanded','Expanded the work area from approximately 1,000 m² to 2,000 m².'],['2017','Export','Began exporting wooden panels to the UAE and Western Europe.'],['2018','Japan','Started exporting wooden panels to Japan.'],['2019','United States','Started exporting cabinetry to the United States.']],strength:'our strengths.',serviceLead:'We continue to strengthen our capabilities to become the right partner for a wide range of woodworking manufacturing requirements.',diff:'We differentiate ourselves through:',diffItems:[...serviceDifferentiators],oemLead:'OEM and ODM production gives clients access to manufacturing space, machinery, production expertise, and scale without carrying the full factory investment internally.',oemLead2:'The model supports capital efficiency, flexible capacity, and stronger production planning.',portfolio:'Project imagery from Mahogani’s public portfolio.',privacy:'There are project relationships that cannot be publicly mentioned due to privacy policy.',form:'Send Us A Message',name:'Name',email:'Email Address',phone:'Phone',question:'Comments / Questions',send:'Send via WhatsApp',info:'Contact Info',location:'Our Location',ourEmail:'Our Email',follow:'Follow Us'
};
const meta=copy.meta[page]??copy.meta.home;
const pageImage=page==='interior'?interiorGallery[0]:page==='commercial'?commercialGallery[0]:page==='oem'?oemGroups[0].images[0]:page==='clients'?source.factory:page==='blog'?blogPosts[0].image:page==='contact'?source.video:source.factory;
const homePosts=blogPosts.slice(0,3);
const gallery=page==='interior'?interiorGallery:commercialGallery;
---
<BaseLayout title={meta[0]} description={meta[1]}>
{page==='home'&&<>
<section class="orig-hero"><img src={source.banner} alt="Mahogani furniture manufacturing" width="2200" height="1467" fetchpriority="high" decoding="async"/><div class="orig-hero-shade"></div><div class="orig-wrap orig-hero-copy" data-reveal><h1>{copy.hero.split('\n').map((line)=><span>{line}</span>)}</h1><p>{copy.sub}</p><div class="orig-actions"><a class="orig-btn orange" href={href('/services/')}>{copy.services} ↗</a><a class="orig-btn light" href={href('/contact-us/')}>{copy.contact}</a></div></div></section>
<section class="orig-about orig-wrap"><h2 class="orig-section-title">{copy.about}</h2><p class="orig-about-lead">{copy.aboutText}</p><div class="orig-capability-layout"><div class="orig-capability-list">{copy.capability.map(([title,body],i)=><article class="orig-capability" data-reveal><img src={source.capabilities[i]} alt="" width="458" height="458" loading="lazy" decoding="async"/><div><h3>{title}</h3><p>{body}</p></div></article>)}</div><div class="orig-factory-photo" data-reveal><img src={source.factory} alt="Mahogani production" width="1600" height="1035" loading="lazy" decoding="async"/></div></div></section>
<section class="orig-video" style={`--orig-video:url('${source.video}')`}><div class="orig-video-shade"></div><div class="orig-video-inner"><h2>{copy.see}</h2><a href="https://www.youtube.com/watch?v=TYadM1PhQmo" target="_blank" rel="noreferrer" aria-label={copy.see}><span>▶</span></a></div></section>
<section class="orig-why orig-wrap"><h2 class="orig-section-title">{copy.why}</h2>{copy.whyItems.map(([title,body],i)=><article class="orig-why-block" data-reveal><div class="orig-why-head"><div><h3>{title}</h3><p>{body}</p></div><span>0{i+1}</span></div><div class="orig-carousel">{whyUsGalleries[i].slice(0,3).map((src,j)=><figure><img src={src} alt={`${title} ${j+1}`} width="1400" height="930" loading="lazy" decoding="async"/></figure>)}</div></article>)}</section>
<section class="orig-worldwide orig-wrap"><div class="orig-worldwide-art"><img src={source.worldwide} alt="" width="1000" height="545" loading="lazy" decoding="async"/></div><div><h2 class="orig-section-title">{copy.worldwide}</h2><p>{copy.worldwideText}</p></div></section>
<section class="orig-projects"><div class="orig-wrap orig-section-head"><h2 class="orig-section-title">{copy.projects}</h2><a class="orig-btn orange" href={href('/clients/')}>{copy.allProjects} ↗</a></div><div class="orig-project-grid">{projectNames.map((name,i)=><a href={href('/clients/')} class="orig-project" style={`--project:url('${source.projects[i]}')`}><span>{String(i+1).padStart(2,'0')}</span><h3>{name}</h3></a>)}</div></section>
<section class="orig-blog orig-wrap"><div class="orig-section-head"><h2 class="orig-section-title">{copy.blog}</h2><a class="orig-btn orange" href={href('/blog/')}>{copy.allBlog} ↗</a></div><div class="orig-blog-grid">{homePosts.map((post)=><a class="orig-post" href={post.href} target="_blank" rel="noreferrer"><img src={post.image} alt={post.title} width="1200" height="800" loading="lazy" decoding="async"/><small>{post.category} · {post.author}</small><h3>{post.title}</h3><p>{post.excerpt}</p><b>{copy.read} ↗</b></a>)}</div><div class="orig-load"><a class="orig-btn orange" href={href('/blog/')}>{copy.load}</a></div></section>
<section class="orig-cta orig-wrap"><div><h2>{copy.contactTitle}</h2><p>{copy.contactText}</p></div><a class="orig-btn white" href={href('/contact-us/')}>{copy.contact} ↗</a></section>
</>}
{page!=='home'&&<>
<section class="orig-page-hero"><img src={pageImage} alt="" width="1800" height="1100" fetchpriority="high" decoding="async"/><div></div><div class="orig-wrap"><h1>{copy.titles[page]}</h1></div></section>
{page==='about'&&<><section class="orig-about orig-wrap"><h2 class="orig-section-title">{copy.about}</h2><p class="orig-about-lead">{copy.aboutText}</p><div class="orig-capability-layout"><div class="orig-capability-list">{copy.capability.map(([title,body],i)=><article class="orig-capability"><img src={source.capabilities[i]} alt="" width="458" height="458" loading="lazy"/><div><h3>{title}</h3><p>{body}</p></div></article>)}</div><div class="orig-factory-photo"><img src={source.factory} alt="Mahogani production" width="1600" height="1035" loading="lazy"/></div></div></section><section class="orig-why orig-wrap"><h2 class="orig-section-title">{copy.why}</h2>{copy.whyItems.map(([title,body],i)=><article class="orig-why-block"><div class="orig-why-head"><div><h3>{title}</h3><p>{body}</p></div><span>0{i+1}</span></div><div class="orig-carousel">{whyUsGalleries[i].slice(0,3).map((src,j)=><figure><img src={src} alt={`${title} ${j+1}`} width="1400" height="930" loading="lazy"/></figure>)}</div></article>)}</section><section class="orig-worldwide orig-wrap"><div class="orig-worldwide-art"><img src={source.worldwide} alt="" width="1000" height="545" loading="lazy"/></div><div><h2 class="orig-section-title">{copy.worldwide}</h2><p>{copy.worldwideText}</p></div></section><section class="orig-values orig-wrap"><article><h2>{copy.vision}</h2><p>{copy.visionText}</p></article><article><h2>{copy.mission}</h2><ul>{copy.missionItems.map((item)=><li>{item}</li>)}</ul></article></section><section class="orig-wrap orig-value-section"><h2 class="orig-section-title">{copy.values}</h2><div class="orig-value-grid">{copy.valueItems.map(([title,body])=><article><h3>{title}</h3><p>{body}</p></article>)}</div></section><section class="orig-wrap orig-milestones"><h2 class="orig-section-title">{copy.milestones}</h2><div>{copy.timeline.map(([year,title,body])=><article><time>{year}</time><h3>{title}</h3><p>{body}</p></article>)}</div></section></>}
{page==='services'&&<><section class="orig-wrap orig-service-intro"><h2 class="orig-section-title">{copy.strength}</h2><p class="orig-about-lead">{copy.serviceLead}</p><h3>{copy.diff}</h3><div class="orig-diff-grid">{copy.diffItems.map((item,i)=><div><span>{String(i+1).padStart(2,'0')}</span><strong>{item}</strong></div>)}</div></section><section class="orig-service-cards orig-wrap">{[[isId?'Produk OEM / ODM':'OEM / ODM Product',oemGroups[0].images[0],'/services/oem-and-odm-product/'],[isId?'Kontraktor Interior':'Interior Contractor',interiorGallery[0],'/services/interior-contractor/'],[isId?'Hunian & Komersial':'Home and Commercial',commercialGallery[0],'/services/home-and-commercial/']].map(([title,img,path])=><a href={href(path)}><img src={img} alt={title} width="1400" height="930" loading="lazy"/><h2>{title}</h2><span>{isId?'Lihat layanan':'View service'} ↗</span></a>)}</section></>}
{page==='oem'&&<><section class="orig-wrap orig-oem-intro"><h2 class="orig-section-title">OEM / ODM</h2><div><p>{copy.oemLead}</p><p>{copy.oemLead2}</p></div></section>{oemGroups.map((group,i)=><section class="orig-wrap orig-product"><div class="orig-product-head"><span>0{i+1}</span><div><h2>{group.title}</h2><p>{group.body}</p></div></div><div class="orig-product-grid">{group.images.map((img,j)=><figure><img src={img} alt={`${group.title} ${j+1}`} width="1400" height="1000" loading="lazy" decoding="async"/><figcaption>{String(j+1).padStart(2,'0')}</figcaption></figure>)}</div></section>)}</>}
{(page==='interior'||page==='commercial')&&<section class="orig-wrap orig-portfolio"><h2 class="orig-section-title">{page==='interior'?(isId?'proyek interior.':'interior projects.'):(isId?'hunian & komersial.':'home & commercial.')}</h2><p class="orig-about-lead">{copy.portfolio}</p><div class="orig-gallery">{gallery.map((img,i)=><figure><img src={img} alt={`${copy.titles[page]} ${i+1}`} width="1400" height="1000" loading="lazy" decoding="async"/><figcaption>{String(i+1).padStart(2,'0')}</figcaption></figure>)}</div></section>}
{page==='clients'&&<section class="orig-wrap orig-clients"><h2 class="orig-section-title">{isId?'klien.':'clients.'}</h2><div class="orig-logo-grid">{clientLogos.map(([name,img])=><div><img src={img} alt={`${name} logo`} width="260" height="120" loading="lazy" decoding="async"/><span>{name}</span></div>)}</div><p class="orig-privacy">{copy.privacy}</p></section>}
{page==='blog'&&<section class="orig-wrap orig-blog"><h2 class="orig-section-title">{copy.blog}</h2><div class="orig-blog-grid">{blogPosts.map((post)=><a class="orig-post" href={post.href} target="_blank" rel="noreferrer"><img src={post.image} alt={post.title} width="1200" height="800" loading="lazy"/><small>{post.category} · {post.author}</small><h3>{post.title}</h3><p>{post.excerpt}</p><b>{copy.read} ↗</b></a>)}</div></section>}
{page==='contact'&&<section class="orig-wrap orig-contact"><div><h2 class="orig-section-title">{copy.form}</h2><form id="orig-contact-form"><label>{copy.name}<input name="name" autocomplete="name" required/></label><label>{copy.email}<input type="email" name="email" autocomplete="email" required/></label><label>{copy.phone}<input type="tel" name="phone" autocomplete="tel"/></label><label>{copy.question}<textarea name="scope" required></textarea></label><button type="submit">{copy.send} ↗</button></form></div><aside><h2 class="orig-section-title">{copy.info}</h2><div><small>{copy.location}</small><p>{site.factory}</p></div><div><small>{copy.ourEmail}</small><p><a href={`mailto:${site.legacyEmail}`}>{site.legacyEmail}</a><br/><a href={`mailto:${site.email}`}>{site.email}</a></p></div><div><small>{copy.phone}</small><p>{site.phone.join(' · ')}<br/><a href={`https://wa.me/${site.whatsapp}`}>+62 877 4760 3739</a></p></div><div><small>{copy.follow}</small><p><a href={site.instagram} target="_blank" rel="noreferrer">Instagram ↗</a></p></div></aside></section>}
{page==='contact'&&<script is:inline define:vars={{whatsapp:site.whatsapp,isId}}>document.getElementById('orig-contact-form')?.addEventListener('submit',(event)=>{event.preventDefault();const form=new FormData(event.currentTarget);const labels=isId?['Nama','Email','Telepon','Komentar / Pertanyaan']:['Name','Email','Phone','Comments / Questions'];const intro=isId?'Halo Mahogani, saya ingin mendiskusikan proyek.':'Hello Mahogani, I would like to discuss a project.';const msg=[intro,`${labels[0]}: ${form.get('name')||'-'}`,`${labels[1]}: ${form.get('email')||'-'}`,`${labels[2]}: ${form.get('phone')||'-'}`,`${labels[3]}: ${form.get('scope')||'-'}`].join('\n');window.open(`https://wa.me/${whatsapp}?text=${encodeURIComponent(msg)}`,'_blank','noopener,noreferrer');});</script>}
</>}
</BaseLayout>
