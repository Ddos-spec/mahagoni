---
const youtube = 'https://www.youtube.com/watch?v=TYadM1PhQmo';
const instagram = 'https://www.instagram.com/mahoganiutama';
---
<script is:inline define:vars={{youtube,instagram}}>
(() => {
  const contact = document.querySelector('.orig-contact');
  if (!contact) return;

  const locationBlock = Array.from(contact.querySelectorAll('aside > div')).find((block) => {
    const label = block.querySelector('small')?.textContent?.trim().toLowerCase() || '';
    return label.includes('location') || label.includes('lokasi');
  });
  const locationText = locationBlock?.querySelector('p');
  if (locationText && !locationText.querySelector('a')) {
    const address = locationText.textContent?.trim() || '';
    const mapUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address)}`;
    const link = document.createElement('a');
    link.className = 'orig-map-link';
    link.href = mapUrl;
    link.target = '_blank';
    link.rel = 'noreferrer';
    link.textContent = address;
    link.setAttribute('aria-label', `Open ${address} in Google Maps`);
    locationText.textContent = '';
    locationText.appendChild(link);
  }

  const socials = contact.querySelector('.orig-socials');
  if (socials) {
    socials.innerHTML = `
      <a class="social-icon" href="${instagram}" target="_blank" rel="noreferrer" aria-label="Instagram Mahogani Utama" title="Instagram">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7.75 2h8.5A5.76 5.76 0 0 1 22 7.75v8.5A5.76 5.76 0 0 1 16.25 22h-8.5A5.76 5.76 0 0 1 2 16.25v-8.5A5.76 5.76 0 0 1 7.75 2Zm0 2A3.75 3.75 0 0 0 4 7.75v8.5A3.75 3.75 0 0 0 7.75 20h8.5A3.75 3.75 0 0 0 20 16.25v-8.5A3.75 3.75 0 0 0 16.25 4h-8.5ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6Zm5.25-3.25a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5Z"/></svg>
      </a>
      <a class="social-icon" href="${youtube}" target="_blank" rel="noreferrer" aria-label="YouTube Mahogani Utama" title="YouTube">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.7V8.3L16 12l-6.4 3.7Z"/></svg>
      </a>`;
  }
})();
</script>
