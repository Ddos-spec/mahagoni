---
interface Props { images: string[]; prefix?: string; }
const { images, prefix='Mahogani project' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.startsWith(base) ? Astro.url.pathname.slice(base.length) || '/' : Astro.url.pathname;
const selectedWork = path.startsWith('/id/') ? 'Karya terpilih' : 'Selected work';
---
<div class="gallery-grid">
  {images.map((src, i) => (
    <figure class:list={['gallery-item', {'gallery-wide': i % 6 === 0 || i % 6 === 5}]} data-reveal>
      <div class="gallery-media"><img src={src} alt={`${prefix} ${String(i+1).padStart(2,'0')}`} width="1200" height="900" loading="lazy" decoding="async" /></div>
      <figcaption><span>{String(i+1).padStart(2,'0')}</span><span>{selectedWork}</span></figcaption>
    </figure>
  ))}
</div>
