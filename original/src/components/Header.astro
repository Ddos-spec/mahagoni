---
import { site } from '@/data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.startsWith(base) ? Astro.url.pathname.slice(base.length) || '/' : Astro.url.pathname;
const withBase = (href: string) => `${base}${href}`;
const logo = site.logo.startsWith('/') ? `${base}${site.logo}` : site.logo;
const isId = path.startsWith('/id/');
const root = isId ? '/id' : '/en';
const c = isId ? {
  home:'Beranda', about:'Tentang', services:'Layanan', oem:'OEM dan ODM Product', interior:'Kontraktor Interior', commercial:'Hunian dan Komersial', clients:'Klien', blog:'Artikel', contact:'Hubungi Kami', menu:'Menu', switchLabel:'EN', switchAria:'Switch to American English'
} : {
  home:'Home', about:'About', services:'Services', oem:'OEM And ODM Product', interior:'Interior Contractor', commercial:'Home and Commercial', clients:'Clients', blog:'Blog', contact:'Contact Us', menu:'Menu', switchLabel:'ID', switchAria:'Ganti ke Bahasa Indonesia'
};
const counterpart = isId ? path.replace(/^\/id\//,'/en/') : path.replace(/^\/en\//,'/id/');
const active = (suffix:string) => path === `${root}${suffix}` || (suffix === '/services/' && path.startsWith(`${root}/services/`));
---
<header class="site-header classic-site-header" data-header>
  <a class="brand" href={withBase(`${root}/`)} aria-label="Mahogani home">
    <span class="brand-crop"><img src={logo} width="473" height="129" alt="Mahogani Utama Indonesia" decoding="async" /></span>
  </a>
  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav"><span>{c.menu}</span><i></i><i></i></button>
  <nav id="site-nav" class="site-nav classic-site-nav" aria-label="Primary navigation">
    <a href={withBase(`${root}/`)} class:list={{active:active('/')}}>{c.home}</a>
    <a href={withBase(`${root}/about/`)} class:list={{active:active('/about/')}}>{c.about}</a>
    <div class="service-menu">
      <a class:list={{active:active('/services/')}} href={withBase(`${root}/services/`)} aria-haspopup="true">{c.services}<span class="chev">⌄</span></a>
      <div class="service-submenu">
        <a href={withBase(`${root}/services/oem-and-odm-product/`)}>{c.oem}</a>
        <a href={withBase(`${root}/services/interior-contractor/`)}>{c.interior}</a>
        <a href={withBase(`${root}/services/home-and-commercial/`)}>{c.commercial}</a>
      </div>
    </div>
    <a href={withBase(`${root}/clients/`)} class:list={{active:active('/clients/')}}>{c.clients}</a>
    <a href={withBase(`${root}/blog/`)} class:list={{active:active('/blog/')}}>{c.blog}</a>
    <a class="nav-contact" href={withBase(`${root}/contact-us/`)}>{c.contact}</a>
    <a class="lang-switch" href={withBase(counterpart)} data-lang-choice={isId?'en':'id'} aria-label={c.switchAria}>{c.switchLabel}</a>
  </nav>
</header>
<script is:inline>
  const header = document.querySelector('[data-header]');
  const toggle = header?.querySelector('.menu-toggle');
  toggle?.addEventListener('click',()=>{const open=header.classList.toggle('menu-open');toggle.setAttribute('aria-expanded',String(open));document.documentElement.classList.toggle('nav-open',open)});
  header?.querySelectorAll('a').forEach((a)=>a.addEventListener('click',()=>{header.classList.remove('menu-open');document.documentElement.classList.remove('nav-open')}));
  document.querySelectorAll('[data-lang-choice]').forEach((el)=>el.addEventListener('click',()=>{try{localStorage.setItem('mahogani-language',el.getAttribute('data-lang-choice')||'en')}catch{}}));
</script>
