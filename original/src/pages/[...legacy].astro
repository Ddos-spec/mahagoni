---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const mappings = [
  ['tentang','/id/about/'],
  ['layanan','/id/services/'],
  ['layanan/produk-oem-dan-odm','/id/services/oem-and-odm-product/'],
  ['layanan/kontraktor-interior','/id/services/interior-contractor/'],
  ['layanan/rumah-dan-komersial','/id/services/home-and-commercial/'],
  ['artikel','/id/blog/'],
  ['hubungi-kami','/id/contact-us/'],
];
export function getStaticPaths(){
  return mappings.map(([legacy,target])=>({params:{legacy},props:{target}}));
}
const { target } = Astro.props;
const destination = `${base}${target}`;
---
<!doctype html><html lang="id"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,follow"/><meta http-equiv="refresh" content={`0;url=${destination}`}/><link rel="canonical" href={destination}/><title>Mahogani Utama Indonesia</title></head><body><p>Mengarahkan ke <a href={destination}>Mahogani Utama Indonesia</a>…</p><script is:inline define:vars={{destination}}>location.replace(destination);</script></body></html>
